---
import { weddingVenues, daySchedule, venueLocation } from '../../data/schedule';
import CalendarIcon from '../icons/CalendarIcon.astro';
import ClockIcon from '../icons/ClockIcon.astro';
import MapPinIcon from '../icons/MapPinIcon.astro';
import WhatsAppIcon from '../icons/WhatsAppIcon.astro';
import SparklesIcon from '../icons/SparklesIcon.astro';
import TicketIcon from '../icons/TicketIcon.astro';
import CalendarButtons from '../ui/CalendarButtons.astro';
import { withBase } from '../../utils/paths';
---
<section class="seccion seccion--profundo" id="ceremonia">
  <div class="interior">
    <div class="seccion-header">
      <div class="ceremonia__badge">
        <CalendarIcon size={20} class="text-[#D4AF37]" />
        <span>El Gran Día</span>
      </div>
      <p class="kicker">Guarda la fecha</p>
      <h2 class="titulo-seccion">Ceremonia y celebración</h2>
      <p class="descripcion-seccion">
        Sábado 12 de junio de 2027 · Hacienda San José, Carretera Arequipa–Yura Km 8
      </p>
    </div>

    <!-- Tarjetas de Ceremonia y Recepción -->
    <div class="lugares-grid">
      {weddingVenues.map((venue, idx) => (
        <article class={`lugar-card revelar ${idx === 1 ? 'revelar--retraso-1' : ''}`}>
          <div class="lugar__foto">
            <img
              src={withBase(venue.image)}
              alt={venue.title}
              width="800"
              height="500"
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="lugar__cuerpo">
            <div class="lugar__hora-tag">
              <ClockIcon size={18} />
              <span>{venue.time}</span>
            </div>
            <h3 class="lugar__titulo">{venue.title}</h3>
            <p class="lugar__nombre">{venue.name}</p>
            <p class="lugar__dir">
              <MapPinIcon size={16} class="lugar__pin-icon" />
              <span>{venue.location}</span>
            </p>
            <p class="lugar__desc">{venue.description}</p>
          </div>
        </article>
      ))}
    </div>

    <!-- Programa hora por hora: Itinerario de Gala -->
    <div class="programa-bloque revelar">
      <div class="programa-card">
        <div class="programa-card__header">
          <div class="programa-card__icono">
            <ClockIcon size={22} class="text-[#D4AF37]" />
          </div>
          <h3 class="programa__titulo">
            <span>Itinerario de la Noche</span>
          </h3>
          <p class="programa__sub">Cronograma concebido para disfrutar del crepúsculo y las estrellas de Arequipa</p>
        </div>

        <div class="programa-timeline">
          {daySchedule.map((item, index) => (
            <div class="programa-item">
              <div class="programa-hora-box">
                <span class="programa-hora">{item.time}</span>
                <span class="programa-punto" aria-hidden="true"></span>
              </div>
              <div class="programa-info">
                <h4 class="programa-evento">{item.title}</h4>
                <p class="programa-desc">{item.description}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Mapa interactivo -->
    <div class="mapa-wrapper revelar">
      <div class="mapa-frame">
        <iframe
          title="Ubicación de la Hacienda San José, Km 8 Carretera Arequipa-Yura"
          src={venueLocation.mapEmbedUrl}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        ></iframe>
      </div>
      <div class="mapa-info">
        <p>Hacienda San José · Carretera Arequipa–Yura Km 8. El mapa muestra la ubicación de referencia. Pulsa para iniciar tu ruta en tiempo real:</p>

        <!-- Botones de Navegación GPS directa -->
        <div class="mapa-acciones">
          <a
            class="boton-gps boton-gps--google"
            target="_blank"
            rel="noopener noreferrer"
            href="https://www.google.com/maps/search/?api=1&query=Hacienda+San+Jose+Carretera+Arequipa+Yura+Km+8+Arequipa"
            aria-label="Abrir ruta en Google Maps"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
            <span>Abrir en Google Maps</span>
          </a>

          <a
            class="boton-gps boton-gps--waze"
            target="_blank"
            rel="noopener noreferrer"
            href="https://waze.com/ul?q=Hacienda+San+Jose+Arequipa+Yura&navigate=yes"
            aria-label="Abrir ruta en Waze"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 2C6.48 2 2 6.48 2 12c0 1.54.36 2.98.97 4.29L2 22l5.71-.97C9.02 21.64 10.46 22 12 22c5.52 0 10-4.48 10-10S17.52 2 12 2zm-2.5 12a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3zm5 0a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3z"/>
            </svg>
            <span>Abrir en Waze</span>
          </a>

          <a
            class="boton-gps boton-gps--wa"
            target="_blank"
            rel="noopener noreferrer"
            href={`https://wa.me/51999777666?text=${encodeURIComponent(venueLocation.whatsappLocationText)}`}
            aria-label="Pedir ubicación exacta por WhatsApp"
          >
            <WhatsAppIcon size={18} />
            <span>Coordenadas por WhatsApp</span>
          </a>

          <button
            type="button"
            class="boton-gps boton-gps--pase"
            id="btn-ver-pase-digital"
            aria-label="Ver Pase Digital de Asistencia con código QR"
          >
            <TicketIcon size={18} />
            <span>Pase Digital con QR</span>
          </button>
        </div>

        <!-- Agendar al calendario -->
        <div class="seccion-cal-wrap">
          <p class="cal-hint">¿Deseas guardar la fecha en tu calendario?</p>
          <CalendarButtons variant="seccion" />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .ceremonia__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 1rem;
    font-size: 0.82rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--dorado);
    background: rgba(212, 175, 55, 0.1);
    border: 1px solid var(--linea);
    border-radius: var(--radio-full);
    margin-bottom: 0.9rem;
  }

  .lugares-grid {
    display: grid;
    gap: 2rem;
    margin-bottom: 4.5rem;
  }

  @media (min-width: 768px) {
    .lugares-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .lugar-card {
    background: rgba(11, 29, 58, 0.7);
    border: 1px solid var(--linea);
    border-radius: var(--radio-md);
    overflow: hidden;
    box-shadow: var(--sombra-suave);
    transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .lugar-card:hover {
    box-shadow: var(--sombra-hover);
    border-color: var(--dorado);
    transform: translateY(-6px);
  }

  .lugar__foto {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--noche);
  }

  .lugar__foto img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .lugar-card:hover .lugar__foto img {
    transform: scale(1.05);
  }

  .lugar__cuerpo {
    padding: 1.85rem;
  }

  .lugar__hora-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-bottom: 0.6rem;
    font-family: var(--titulo);
    font-size: 1.75rem;
    font-weight: 500;
    color: var(--dorado);
  }

  .lugar__titulo {
    font-size: clamp(1.65rem, 3.5vw, 1.95rem);
    color: var(--dorado);
    margin-bottom: 0.4rem;
    line-height: 1.2;
  }

  .lugar__nombre {
    font-weight: 600;
    font-size: 1.15rem;
    color: #FFF6D6;
    margin-bottom: 0.35rem;
  }

  .lugar__dir {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.95rem;
    color: var(--plata);
    margin-bottom: 0.85rem;
  }

  .lugar__pin-icon {
    color: var(--dorado);
    flex-shrink: 0;
  }

  .lugar__desc {
    font-size: 0.98rem;
    line-height: 1.68;
    color: var(--crema);
    opacity: 0.94;
    margin: 0;
  }

  /* Programa: Itinerario de Gala */
  .programa-bloque {
    max-width: 50rem;
    margin: 0 auto 5rem;
  }

  .programa-card {
    background: radial-gradient(circle at top, rgba(74, 59, 107, 0.3) 0%, rgba(11, 29, 58, 0.8) 100%);
    border: 1px solid var(--linea);
    border-radius: var(--radio-lg);
    padding: clamp(2rem, 4vw, 3rem) clamp(1.5rem, 3.5vw, 2.75rem);
    box-shadow: 0 16px 45px rgba(0, 0, 0, 0.5), 0 0 25px rgba(212, 175, 55, 0.1);
    position: relative;
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }

  .programa-card::before {
    content: "";
    position: absolute;
    inset: 8px;
    border: 1px solid rgba(212, 175, 55, 0.18);
    border-radius: calc(var(--radio-lg) - 6px);
    pointer-events: none;
  }

  .programa-card__header {
    text-align: center;
    margin-bottom: 2.25rem;
  }

  .programa-card__icono {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--radio-full);
    background: rgba(212, 175, 55, 0.12);
    border: 1px solid var(--linea);
    margin-bottom: 0.75rem;
  }

  .programa__titulo {
    font-size: clamp(2rem, 4vw, 2.4rem);
    color: var(--dorado);
    margin: 0 0 0.35rem;
  }

  .programa__sub {
    font-size: 0.98rem;
    color: var(--plata);
    margin: 0;
  }

  .programa-timeline {
    position: relative;
    display: grid;
    gap: 1.5rem;
  }

  .programa-item {
    display: grid;
    grid-template-columns: 8.5rem 1fr;
    gap: 1.5rem;
    padding: 1.25rem 1.45rem;
    background: rgba(7, 16, 32, 0.65);
    border: 1px solid var(--linea-suave);
    border-radius: var(--radio-md);
    align-items: center;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .programa-item:hover {
    transform: translateX(6px);
    border-color: var(--dorado);
    background: rgba(27, 42, 74, 0.7);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.4), 0 0 15px rgba(212, 175, 55, 0.2);
  }

  .programa-hora-box {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .programa-hora {
    font-family: var(--titulo);
    font-size: 1.45rem;
    font-weight: 600;
    color: var(--dorado);
    white-space: nowrap;
  }

  .programa-punto {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--dorado);
    box-shadow: 0 0 10px var(--dorado);
    animation: brillar-estrella 2.5s infinite alternate;
  }

  .programa-info {
    margin: 0;
  }

  .programa-evento {
    font-size: 1.15rem;
    font-weight: 600;
    color: #FFF6D6;
    margin-bottom: 0.25rem;
  }

  .programa-desc {
    font-size: 0.92rem;
    color: var(--crema);
    opacity: 0.9;
    margin: 0;
    line-height: 1.58;
  }

  @media (max-width: 620px) {
    .programa-item {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }

    .programa-punto {
      display: none;
    }
  }

  /* Mapa */
  .mapa-wrapper {
    max-width: 54rem;
    margin: 0 auto;
    text-align: center;
  }

  .mapa-frame {
    aspect-ratio: 16 / 8;
    min-height: 16rem;
    overflow: hidden;
    border: 1px solid var(--linea);
    border-radius: var(--radio-md);
    box-shadow: var(--sombra-suave);
    margin-bottom: 1.5rem;
    background: var(--noche);
  }

  .mapa-frame iframe {
    width: 100%;
    height: 100%;
    border: 0;
  }

  .mapa-info p {
    color: var(--plata);
    font-size: 0.95rem;
    max-width: 36rem;
    margin: 0 auto 1.25rem;
    line-height: 1.6;
  }

  .mapa-acciones {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-bottom: 2rem;
  }

  .boton-gps {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.65rem 1.2rem;
    border-radius: var(--radio-md);
    font-size: 0.88rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.22s ease;
    cursor: pointer;
  }

  .boton-gps--google {
    background: rgba(212, 175, 55, 0.15);
    color: #FFF2A8;
    border: 1px solid rgba(212, 175, 55, 0.4);
  }

  .boton-gps--google:hover {
    background: rgba(212, 175, 55, 0.3);
    border-color: #D4AF37;
    transform: translateY(-2px);
    box-shadow: 0 4px 15px rgba(212, 175, 55, 0.25);
  }

  .boton-gps--waze {
    background: rgba(51, 153, 255, 0.15);
    color: #99CCFF;
    border: 1px solid rgba(51, 153, 255, 0.4);
  }

  .boton-gps--waze:hover {
    background: rgba(51, 153, 255, 0.25);
    border-color: #3399FF;
    transform: translateY(-2px);
    box-shadow: 0 4px 15px rgba(51, 153, 255, 0.25);
  }

  .boton-gps--wa {
    background: rgba(37, 211, 102, 0.15);
    color: #80ECA0;
    border: 1px solid rgba(37, 211, 102, 0.4);
  }

  .boton-gps--wa:hover {
    background: rgba(37, 211, 102, 0.25);
    border-color: #25D366;
    transform: translateY(-2px);
    box-shadow: 0 4px 15px rgba(37, 211, 102, 0.25);
  }

  .boton-gps--pase {
    background: linear-gradient(135deg, rgba(212, 175, 55, 0.25) 0%, rgba(163, 92, 126, 0.25) 100%);
    color: #FFF6D6;
    border: 1px solid var(--dorado);
    box-shadow: 0 4px 15px rgba(212, 175, 55, 0.2);
  }

  .boton-gps--pase:hover {
    background: linear-gradient(135deg, rgba(212, 175, 55, 0.4) 0%, rgba(163, 92, 126, 0.4) 100%);
    border-color: #FFE58F;
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(212, 175, 55, 0.35);
  }

  .seccion-cal-wrap {
    padding-top: 1.25rem;
    border-top: 1px solid var(--linea-suave);
  }

  .cal-hint {
    font-size: 0.88rem !important;
    color: var(--dorado) !important;
    margin-bottom: 0.4rem !important;
  }
</style>

<script>
  function setupPaseTrigger() {
    const btn = document.getElementById('btn-ver-pase-digital');
    if (!btn) return;
    btn.addEventListener('click', () => {
      window.dispatchEvent(new CustomEvent('abrir-pase-digital'));
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupPaseTrigger);
  } else {
    setupPaseTrigger();
  }
</script>

