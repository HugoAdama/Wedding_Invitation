---
import { weddingVenues } from '../../data/schedule';
import CalendarIcon from '../icons/CalendarIcon.astro';
import ClockIcon from '../icons/ClockIcon.astro';
import MapPinIcon from '../icons/MapPinIcon.astro';
import DayScheduleTimeline from '../ui/DayScheduleTimeline.astro';
import VenueLocationMap from '../ui/VenueLocationMap.astro';
import { withBase } from '../../utils/paths';
---
<section class="seccion seccion--profundo" id="ceremonia">
  <div class="interior">
    <div class="seccion-header">
      <div class="ceremonia__badge">
        <CalendarIcon size={20} class="text-[#D4AF37]" />
        <span>El Gran Día</span>
      </div>
      <p class="kicker">Guarda la fecha</p>
      <h2 class="titulo-seccion">Ceremonia y celebración</h2>
      <p class="descripcion-seccion">
        Sábado 12 de junio de 2027 · Hacienda San José, Carretera Arequipa–Yura Km 8
      </p>
    </div>

    <!-- Tarjetas de Ceremonia y Recepción -->
    <div class="lugares-grid">
      {weddingVenues.map((venue, idx) => (
        <article class={`lugar-card revelar ${idx === 1 ? 'revelar--retraso-1' : ''}`}>
          <div class="lugar__foto">
            <img
              src={withBase(venue.image)}
              alt={venue.title}
              width="800"
              height="500"
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="lugar__cuerpo">
            <div class="lugar__hora-tag">
              <ClockIcon size={18} />
              <span>{venue.time}</span>
            </div>
            <h3 class="lugar__titulo">{venue.title}</h3>
            <p class="lugar__nombre">{venue.name}</p>
            <p class="lugar__dir">
              <MapPinIcon size={16} class="lugar__pin-icon" />
              <span>{venue.location}</span>
            </p>
            <p class="lugar__desc">{venue.description}</p>
          </div>
        </article>
      ))}
    </div>

    <!-- Programa hora por hora: Itinerario de Gala (Componente modular) -->
    <DayScheduleTimeline />

    <!-- Mapa interactivo y acciones GPS (Componente modular) -->
    <VenueLocationMap />
  </div>
</section>

<style>
  .ceremonia__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 1rem;
    font-size: 0.82rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--dorado);
    background: rgba(212, 175, 55, 0.1);
    border: 1px solid var(--linea);
    border-radius: var(--radio-full);
    margin-bottom: 0.9rem;
  }

  .lugares-grid {
    display: grid;
    gap: 2rem;
    margin-bottom: 4.5rem;
  }

  @media (min-width: 768px) {
    .lugares-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .lugar-card {
    background: rgba(11, 29, 58, 0.7);
    border: 1px solid var(--linea);
    border-radius: var(--radio-md);
    overflow: hidden;
    box-shadow: var(--sombra-suave);
    transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .lugar-card:hover {
    box-shadow: var(--sombra-hover);
    border-color: var(--dorado);
    transform: translateY(-6px);
  }

  .lugar__foto {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--noche);
  }

  .lugar__foto img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .lugar-card:hover .lugar__foto img {
    transform: scale(1.05);
  }

  .lugar__cuerpo {
    padding: 1.85rem;
  }

  .lugar__hora-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-bottom: 0.6rem;
    font-family: var(--titulo);
    font-size: 1.75rem;
    font-weight: 500;
    color: var(--dorado);
  }

  .lugar__titulo {
    font-size: clamp(1.65rem, 3.5vw, 1.95rem);
    color: var(--dorado);
    margin-bottom: 0.4rem;
    line-height: 1.2;
  }

  .lugar__nombre {
    font-weight: 600;
    font-size: 1.15rem;
    color: #FFF6D6;
    margin-bottom: 0.35rem;
  }

  .lugar__dir {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.95rem;
    color: var(--plata);
    margin-bottom: 0.85rem;
  }

  .lugar__pin-icon {
    color: var(--dorado);
    flex-shrink: 0;
  }

  .lugar__desc {
    font-size: 0.98rem;
    line-height: 1.68;
    color: var(--crema);
    opacity: 0.94;
    margin: 0;
  }
</style>
