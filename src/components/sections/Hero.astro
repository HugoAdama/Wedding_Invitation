---
import { weddingData } from '../../data/wedding';
import SparklesIcon from '../icons/SparklesIcon.astro';
import HeartIcon from '../icons/HeartIcon.astro';
import ShootingStars from '../ui/ShootingStars.astro';
import CalendarButtons from '../ui/CalendarButtons.astro';
import { withBase } from '../../utils/paths';
---
<section class="hero cielo" id="inicio">
  <ShootingStars />

  <div class="hero__contenedor">
    <!-- Velo de Aurora Boreal cósmica de fondo -->
    <div class="hero__aurora" aria-hidden="true">
      <div class="aurora-velo aurora-velo--1"></div>
      <div class="aurora-velo aurora-velo--2"></div>
      <div class="aurora-velo aurora-velo--3"></div>
    </div>
    
    <figure class="luna-portal pulso-lunar">
      <img
        src={withBase('/images/hero-stars.webp')}
        alt="Daniela y Rodrigo contemplando la Vía Láctea en Arequipa"
        width="800"
        height="800"
        loading="eager"
        fetchpriority="high"
      />
      <div class="luna-brillo"></div>
    </figure>

    <div class="hero__badge hero__badge--aurora">
      <SparklesIcon size={16} class="text-[#2DD4BF] anim-sparkle" />
      <span>Nuestra Boda</span>
      <SparklesIcon size={16} class="text-[#D4AF37] anim-sparkle" />
    </div>

    <p class="hero__aviso">Bajo las estrellas</p>

    <h1 class="hero__nombres">
      <span class="hero__nombre brillo-aurora">{weddingData.brideName}</span>
      <span class="hero__y">&amp;</span>
      <span class="hero__nombre brillo-aurora">{weddingData.groomName}</span>
    </h1>

    <p class="hero__fecha">{weddingData.dateFormatted}</p>
    <p class="hero__lugar">{weddingData.venueName} · {weddingData.city}</p>

    <!-- Badge de Invitación Personalizada si viene en URL -->
    <div class="hero__invitado-badge" id="hero-invitado-badge" hidden>
      <SparklesIcon size={15} class="text-[#D4AF37]" />
      <span>Especialmente para: <strong id="hero-invitado-nombre"></strong></span>
      <span class="invitado-pases-chip" id="hero-invitado-pases" hidden></span>
    </div>

    <!-- Cuenta regresiva estelar en portada -->
    <div class="hero__countdown" id="hero-countdown" role="timer" aria-label="Tiempo restante para la boda">
      <div class="hero__count-box">
        <span class="hero__count-num" id="hero-dias">--</span>
        <span class="hero__count-txt">Días</span>
      </div>
      <span class="hero__count-sep" aria-hidden="true">:</span>
      <div class="hero__count-box">
        <span class="hero__count-num" id="hero-horas">--</span>
        <span class="hero__count-txt">Horas</span>
      </div>
      <span class="hero__count-sep" aria-hidden="true">:</span>
      <div class="hero__count-box">
        <span class="hero__count-num" id="hero-minutos">--</span>
        <span class="hero__count-txt">Minutos</span>
      </div>
      <span class="hero__count-sep" aria-hidden="true">:</span>
      <div class="hero__count-box">
        <span class="hero__count-num" id="hero-segundos">--</span>
        <span class="hero__count-txt">Segundos</span>
      </div>
    </div>

    <div class="hero__botones">
      <a class="boton boton--lleno" href="#confirmar">
        <HeartIcon size={18} fill={true} class="anim-heart" />
        <span>Confirmar asistencia</span>
      </a>
      <a class="boton" href="#mensaje">
        <span>Ver invitación</span>
      </a>
    </div>

    <!-- Acciones de agendamiento en calendario -->
    <CalendarButtons variant="hero" />
  </div>
</section>

<style>
  .hero {
    display: grid;
    place-items: center;
    min-height: calc(100svh - 4.25rem);
    padding: 3.5rem var(--lado) 5rem;
    text-align: center;
    position: relative;
    background:
      radial-gradient(ellipse at 50% 120%, rgba(212, 175, 55, 0.28) 0%, transparent 55%),
      radial-gradient(ellipse at 50% 85%, var(--violeta) 0%, transparent 68%),
      linear-gradient(180deg, var(--noche) 0%, var(--profundo) 100%);
  }

  .hero__contenedor {
    position: relative;
    z-index: 2;
    max-width: 48rem;
    animation: aparecer 1.1s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .luna-portal {
    position: relative;
    width: min(72vw, 19.5rem);
    aspect-ratio: 1;
    margin: 0 auto 2.25rem;
    padding: 8px;
    border: 1.5px solid var(--dorado);
    border-radius: 50%;
    box-shadow: var(--sombra-luna);
    background: radial-gradient(circle, rgba(27, 42, 74, 0.8) 0%, rgba(11, 29, 58, 0.95) 100%);
    transition: transform 0.4s ease, box-shadow 0.4s ease;
  }

  .luna-portal:hover {
    transform: scale(1.03);
    box-shadow: 0 0 100px rgba(245, 239, 230, 0.45), 0 0 0 16px rgba(212, 175, 55, 0.16);
  }

  .luna-portal img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
    filter: saturate(0.95) brightness(0.98);
  }

  .hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 1rem;
    font-size: 0.82rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--dorado);
    background: rgba(212, 175, 55, 0.1);
    border: 1px solid var(--linea);
    border-radius: var(--radio-full);
    margin-bottom: 0.9rem;
  }

  .anim-sparkle {
    animation: girar-titilar 4s ease-in-out infinite alternate;
  }

  @keyframes girar-titilar {
    0% { transform: scale(0.85) rotate(-10deg); opacity: 0.7; }
    50% { transform: scale(1.15) rotate(15deg); opacity: 1; }
    100% { transform: scale(0.95) rotate(-5deg); opacity: 0.8; }
  }

  .anim-heart {
    animation: latido-suave 2.4s ease-in-out infinite;
  }

  @keyframes latido-suave {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.12); }
  }

  .hero__aviso {
    margin-bottom: 0.4rem;
    font-family: var(--titulo);
    font-style: italic;
    font-size: clamp(1.4rem, 3.5vw, 1.8rem);
    color: #F5EFE6;
    letter-spacing: 0.04em;
    text-shadow: 0 0 16px rgba(45, 212, 191, 0.28);
  }

  .hero__nombres {
    margin-bottom: 1.25rem;
    font-family: var(--script);
    font-weight: 400;
    font-size: clamp(4.4rem, 16vw, 8.2rem);
    line-height: 1.05;
  }

  .hero__nombre {
    display: block;
  }

  .hero__y {
    display: block;
    font-size: 0.5em;
    line-height: 1;
    background: linear-gradient(135deg, #D4AF37 0%, #FFF2A8 50%, #2DD4BF 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    filter: drop-shadow(0 0 12px rgba(212, 175, 55, 0.5));
  }

  /* Badge con halo aurora */
  .hero__badge--aurora {
    background: linear-gradient(135deg, rgba(45, 212, 191, 0.12), rgba(168, 85, 247, 0.1), rgba(212, 175, 55, 0.12));
    border: 1px solid rgba(45, 212, 191, 0.4);
    box-shadow: 0 0 20px rgba(45, 212, 191, 0.15), inset 0 0 10px rgba(212, 175, 55, 0.12);
  }

  /* Velo etéreo de Aurora Boreal cósmica */
  .hero__aurora {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: min(115vw, 56rem);
    height: 42rem;
    pointer-events: none;
    z-index: -1;
    overflow: visible;
  }

  .aurora-velo {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    filter: blur(55px);
    opacity: 0.42;
    mix-blend-mode: screen;
    will-change: transform, opacity;
  }

  .aurora-velo--1 {
    background: radial-gradient(ellipse at 35% 45%, rgba(16, 185, 129, 0.38) 0%, rgba(6, 95, 70, 0.15) 45%, transparent 70%);
    animation: pulsar-aurora-1 12s ease-in-out infinite alternate;
  }

  .aurora-velo--2 {
    background: radial-gradient(ellipse at 65% 55%, rgba(124, 58, 237, 0.32) 0%, rgba(59, 130, 246, 0.18) 45%, transparent 70%);
    animation: pulsar-aurora-2 15s ease-in-out infinite alternate;
  }

  .aurora-velo--3 {
    background: radial-gradient(ellipse at 50% 60%, rgba(212, 175, 55, 0.3) 0%, rgba(45, 212, 191, 0.2) 40%, transparent 65%);
    animation: pulsar-aurora-3 10s ease-in-out infinite alternate;
  }

  @keyframes pulsar-aurora-1 {
    0% { transform: scale(0.9) translate(-5%, -4%) rotate(-3deg); opacity: 0.32; }
    50% { transform: scale(1.1) translate(4%, 3%) rotate(4deg); opacity: 0.5; }
    100% { transform: scale(0.95) translate(-2%, 5%) rotate(-2deg); opacity: 0.38; }
  }

  @keyframes pulsar-aurora-2 {
    0% { transform: scale(1.05) translate(4%, 2%) rotate(3deg); opacity: 0.28; }
    50% { transform: scale(0.92) translate(-6%, -3%) rotate(-4deg); opacity: 0.45; }
    100% { transform: scale(1.08) translate(3%, -2%) rotate(2deg); opacity: 0.32; }
  }

  @keyframes pulsar-aurora-3 {
    0% { transform: scale(0.95) translate(0%, 5%); opacity: 0.22; }
    50% { transform: scale(1.08) translate(0%, -4%); opacity: 0.42; }
    100% { transform: scale(0.98) translate(0%, 3%); opacity: 0.28; }
  }

  @media (min-width: 768px) {
    .hero__nombre,
    .hero__y {
      display: inline;
    }
    .hero__y {
      margin-inline: 0.2em;
    }
  }

  .hero__fecha {
    margin-bottom: 0.35rem;
    font-family: var(--titulo);
    font-size: clamp(1.6rem, 4.2vw, 2.2rem);
    font-weight: 500;
    color: var(--crema);
    letter-spacing: 0.03em;
  }

  .hero__lugar {
    margin-bottom: 2.25rem;
    font-size: 1.05rem;
    color: var(--plata);
    letter-spacing: 0.05em;
  }

  .hero__botones {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
  }

  /* Countdown estelar en el Hero */
  .hero__countdown {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.65rem 1.25rem;
    background: rgba(11, 16, 33, 0.65);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(212, 175, 55, 0.35);
    border-radius: 9999px;
    margin-bottom: 2rem;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.35), 0 0 15px rgba(212, 175, 55, 0.15);
  }

  .hero__count-box {
    display: flex;
    align-items: baseline;
    gap: 0.25rem;
  }

  .hero__count-num {
    font-family: var(--titulo);
    font-size: 1.25rem;
    font-weight: 600;
    color: #FFF2A8;
    line-height: 1;
    min-width: 1.6ch;
    text-align: right;
  }

  .hero__count-txt {
    font-size: 0.7rem;
    color: var(--plata-estelar);
    text-transform: lowercase;
    letter-spacing: 0.04em;
  }

  .hero__count-sep {
    font-size: 1.1rem;
    color: #D4AF37;
    opacity: 0.7;
    font-weight: 300;
    line-height: 1;
    margin-top: -2px;
  }

  /* Badge de Invitado Personalizado */
  .hero__invitado-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 1.15rem;
    background: radial-gradient(circle at center, rgba(74, 59, 107, 0.4) 0%, rgba(11, 29, 58, 0.75) 100%);
    border: 1px solid var(--dorado);
    border-radius: var(--radio-full);
    color: var(--crema);
    font-size: 0.88rem;
    margin: 0.75rem auto 1rem;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4), 0 0 15px rgba(212, 175, 55, 0.25);
    animation: aparecer 0.6s ease;
  }

  .hero__invitado-badge strong {
    color: #FFF4D0;
    font-weight: 600;
  }

  .invitado-pases-chip {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--noche);
    background: var(--dorado);
    padding: 0.15rem 0.5rem;
    border-radius: var(--radio-full);
    letter-spacing: 0.05em;
  }

  @keyframes aparecer {
    from {
      opacity: 0;
      transform: translateY(22px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

<script>
  function initHeroCountdown() {
    const elDias = document.getElementById('hero-dias');
    const elHoras = document.getElementById('hero-horas');
    const elMin = document.getElementById('hero-minutos');
    const elSeg = document.getElementById('hero-segundos');
    if (!elDias || !elHoras || !elMin || !elSeg) return;

    // Sábado 12 de junio de 2027 a las 17:30 (Hora Perú UTC-5)
    const fechaDestino = new Date('2027-06-12T17:30:00-05:00').getTime();
    const pad = (n: number) => String(n).padStart(2, '0');

    function actualizar() {
      const ahora = Date.now();
      const dif = fechaDestino - ahora;
      if (dif <= 0) {
        elDias.textContent = '00';
        elHoras.textContent = '00';
        elMin.textContent = '00';
        elSeg.textContent = '00';
        return;
      }
      const segs = Math.floor(dif / 1000);
      const d = Math.floor(segs / 86400);
      const h = Math.floor((segs % 86400) / 3600);
      const m = Math.floor((segs % 3600) / 60);
      const s = segs % 60;

      elDias.textContent = String(d);
      elHoras.textContent = pad(h);
      elMin.textContent = pad(m);
      elSeg.textContent = pad(s);
    }

    actualizar();
    setInterval(actualizar, 1000);
  }

  function initPersonalizacionInvitado() {
    try {
      const urlParams = new URLSearchParams(window.location.search);
      const para = urlParams.get('para');
      const pases = urlParams.get('pases');

      const badge = document.getElementById('hero-invitado-badge');
      const nombreEl = document.getElementById('hero-invitado-nombre');
      const pasesEl = document.getElementById('hero-invitado-pases');

      if (para && badge && nombreEl) {
        nombreEl.textContent = para;
        badge.hidden = false;

        if (pases && pasesEl) {
          const numPases = parseInt(pases, 10) || 1;
          pasesEl.textContent = `${numPases} ${numPases === 1 ? 'pase' : 'pases'}`;
          pasesEl.hidden = false;
        }

        // Autocompletar también en el formulario RSVP si existe
        const inputNombre = document.getElementById('nombre') as HTMLInputElement | null;
        const inputPersonas = document.getElementById('personas') as HTMLInputElement | null;

        if (inputNombre && !inputNombre.value) {
          inputNombre.value = para;
        }
        if (inputPersonas && pases) {
          inputPersonas.value = pases;
        }
      }
    } catch {
      // Ignorar error de lectura de params
    }
  }

  function initHero() {
    initHeroCountdown();
    initPersonalizacionInvitado();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHero);
  } else {
    initHero();
  }
</script>
