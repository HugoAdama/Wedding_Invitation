---
import { dressCodeDetails, dressCodeCards } from '../../data/dressCode';
import PaletteIcon from '../icons/PaletteIcon.astro';
import SparklesIcon from '../icons/SparklesIcon.astro';
import BrideIcon from '../icons/BrideIcon.astro';
import GroomIcon from '../icons/GroomIcon.astro';
import CheckIcon from '../icons/CheckIcon.astro';
import MoonIcon from '../icons/MoonIcon.astro';
import DressCodePalette from '../ui/DressCodePalette.astro';
import { withBase } from '../../utils/paths';
---
<section class="seccion" id="vestimenta">
  <div class="interior">
    <!-- Encabezado de Sección -->
    <div class="seccion-header">
      <div class="vestir__badge">
        <PaletteIcon size={18} class="text-[#D4AF37]" />
        <span>Código de Etiqueta</span>
      </div>
      <p class="kicker">Para una noche de gala</p>
      <h2 class="titulo-seccion">Vestimenta</h2>
      <p class="descripcion-seccion">
        {dressCodeDetails.category} · Te invitamos a sumar la elegancia y los tonos del cielo nocturno que nos cobijará.
      </p>
    </div>

    <!-- 1. Tarjetas Principales de Inspiración: Damas & Caballeros -->
    <div class="vestir__cards-grid">
      {dressCodeCards.map((card, i) => (
        <article class={`vestir-card revelar ${i === 1 ? 'revelar--retraso-1' : ''}`}>
          <div class="vestir-card__visual">
            <img
              src={withBase(card.image)}
              alt={card.imageAlt}
              width="600"
              height="800"
              loading="lazy"
              decoding="async"
              class="vestir-card__img"
            />
            <div class="vestir-card__badge">
              {card.role === 'damas' ? (
                <BrideIcon size={18} class="text-[#D4AF37]" />
              ) : (
                <GroomIcon size={18} class="text-[#D4AF37]" />
              )}
              <span>{card.title}</span>
            </div>
          </div>

          <div class="vestir-card__cuerpo">
            <h3 class="vestir-card__subtitulo">{card.subtitle}</h3>

            <ul class="vestir-card__puntos">
              {card.guidelines.map(item => (
                <li>
                  <CheckIcon size={16} class="vestir-card__check" />
                  <span>{item}</span>
                </li>
              ))}
            </ul>

            <div class="vestir-card__meta">
              <div class="vestir-meta__fila">
                <span class="meta__label">Tonos sugeridos:</span>
                <span class="meta__valor">{card.suggestedTones}</span>
              </div>
              <div class="vestir-meta__fila">
                <span class="meta__label">Calzado:</span>
                <span class="meta__valor">{card.footwearTip}</span>
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>

    <!-- 2. Paleta Cromática Celestial (Componente modular) -->
    <DressCodePalette />

    <!-- 3. Notas Importantes y Confort Térmico -->
    <div class="vestir__notas-grid revelar">
      <!-- Reserva de color -->
      <aside class="nota-card nota-card--reserva">
        <div class="nota-card__icono-box">
          <SparklesIcon size={22} class="text-[#D4AF37]" />
        </div>
        <div class="nota-card__contenido">
          <span class="nota-card__kicker">Etiqueta Nupcial</span>
          <h4 class="nota-card__titulo">Reserva Exclusiva de Color</h4>
          <p class="nota-card__texto">
            Por deferencia a la novia, solicitamos con cariño <strong>evitar el blanco, marfil y tonos crema</strong>, los cuales quedan reservados exclusivamente para ella.
          </p>
        </div>
      </aside>

      <!-- Clima y abrigo -->
      <aside class="nota-card nota-card--clima">
        <div class="nota-card__icono-box">
          <MoonIcon size={22} class="text-[#7DD3FC]" />
        </div>
        <div class="nota-card__contenido">
          <span class="nota-card__kicker">Confort Térmico</span>
          <h4 class="nota-card__titulo">Noche Fresca en Arequipa</h4>
          <p class="nota-card__texto">
            En junio la temperatura desciende por la noche (~12°C). Sugerimos llevar <strong>estola, chal, saco o abrigo ligero</strong> para disfrutar plácidamente bajo las estrellas.
          </p>
        </div>
      </aside>
    </div>
  </div>
</section>

<style>
  /* Encabezado */
  .vestir__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 1rem;
    font-size: 0.82rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--dorado);
    background: rgba(212, 175, 55, 0.1);
    border: 1px solid var(--linea);
    border-radius: var(--radio-full);
    margin-bottom: 0.9rem;
  }

  /* 1. Grid de Tarjetas Damas & Caballeros */
  .vestir__cards-grid {
    display: grid;
    gap: 2.5rem;
    margin-bottom: 3.5rem;
  }

  @media (min-width: 768px) {
    .vestir__cards-grid {
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
    }
  }

  .vestir-card {
    background: rgba(27, 42, 74, 0.45);
    border: 1px solid var(--linea-suave);
    border-radius: var(--radio-lg);
    overflow: hidden;
    box-shadow: var(--sombra-suave);
    display: flex;
    flex-direction: column;
    transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .vestir-card:hover {
    transform: translateY(-6px);
    border-color: var(--dorado);
    box-shadow: var(--sombra-hover);
  }

  .vestir-card__visual {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 3.5;
    background: var(--noche);
  }

  @media (min-width: 640px) {
    .vestir-card__visual {
      aspect-ratio: 16 / 11;
    }
  }

  .vestir-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 25%;
    display: block;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .vestir-card:hover .vestir-card__img {
    transform: scale(1.06);
  }

  .vestir-card__badge {
    position: absolute;
    bottom: 1rem;
    left: 1.25rem;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.45rem 1.15rem;
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--crema);
    background: rgba(7, 16, 32, 0.88);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid var(--dorado);
    border-radius: var(--radio-full);
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.4);
  }

  .vestir-card__cuerpo {
    padding: clamp(1.75rem, 3.5vw, 2.25rem);
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 1.35rem;
  }

  .vestir-card__subtitulo {
    font-family: var(--titulo);
    font-size: clamp(1.6rem, 2.8vw, 1.95rem);
    color: #FFF2A8;
    margin: 0;
    line-height: 1.22;
  }

  .vestir-card__puntos {
    display: grid;
    gap: 0.85rem;
    font-size: 0.98rem;
    color: var(--crema);
    line-height: 1.65;
    opacity: 0.95;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .vestir-card__puntos li {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
  }

  .vestir-card__check {
    color: var(--dorado);
    flex-shrink: 0;
    margin-top: 0.25rem;
  }

  .vestir-card__meta {
    margin-top: auto;
    padding-top: 1.25rem;
    border-top: 1px solid var(--linea-suave);
    display: grid;
    gap: 0.6rem;
    font-size: 0.88rem;
  }

  .vestir-meta__fila {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  @media (min-width: 480px) {
    .vestir-meta__fila {
      flex-direction: row;
      gap: 0.5rem;
    }
  }

  .meta__label {
    color: var(--plata);
    font-weight: 500;
    flex-shrink: 0;
  }

  .meta__valor {
    color: var(--crema);
    opacity: 0.9;
  }

  /* 3. Notas Inferiores en 2 Columnas */
  .vestir__notas-grid {
    display: grid;
    gap: 1.5rem;
  }

  @media (min-width: 768px) {
    .vestir__notas-grid {
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
    }
  }

  .nota-card {
    display: flex;
    align-items: flex-start;
    gap: 1.25rem;
    padding: 1.5rem 1.75rem;
    border-radius: var(--radio-md);
    box-shadow: var(--sombra-suave);
    transition: transform 0.25s ease, border-color 0.25s ease;
  }

  .nota-card:hover {
    transform: translateY(-2px);
  }

  .nota-card--reserva {
    background: radial-gradient(circle at top left, rgba(74, 59, 107, 0.45) 0%, rgba(27, 42, 74, 0.45) 100%);
    border: 1px solid var(--linea);
    border-left: 4px solid var(--dorado);
  }

  .nota-card--clima {
    background: radial-gradient(circle at top left, rgba(27, 42, 74, 0.6) 0%, rgba(11, 29, 58, 0.65) 100%);
    border: 1px solid var(--linea-suave);
    border-left: 4px solid #7DD3FC;
  }

  .nota-card__icono-box {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--radio-full);
    background: rgba(7, 16, 32, 0.6);
    border: 1px solid var(--linea-suave);
    flex-shrink: 0;
  }

  .nota-card__contenido {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .nota-card__kicker {
    font-size: 0.78rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--plata);
  }

  .nota-card__titulo {
    font-family: var(--titulo);
    font-size: 1.35rem;
    color: var(--crema);
    margin: 0;
  }

  .nota-card--reserva .nota-card__titulo {
    color: var(--dorado);
  }

  .nota-card--clima .nota-card__titulo {
    color: #BAE6FD;
  }

  .nota-card__texto {
    font-size: 0.92rem;
    color: var(--crema);
    line-height: 1.55;
    opacity: 0.92;
    margin: 0;
  }

  .nota-card__texto strong {
    color: #ffffff;
    font-weight: 600;
  }
</style>
