---
import { weddingRecommendations } from '../../data/recommendations';
import MapPinIcon from '../icons/MapPinIcon.astro';
import SparklesIcon from '../icons/SparklesIcon.astro';
import ClockIcon from '../icons/ClockIcon.astro';
import WeatherCard from '../ui/WeatherCard.astro';
import SpotifyPlaylistCard from '../ui/SpotifyPlaylistCard.astro';
---
<section class="seccion seccion-optimizada" id="recomendaciones">
  <div class="interior">
    <div class="seccion-header">
      <p class="kicker">Para que todo salga perfecto</p>
      <h2 class="titulo-seccion">Recomendaciones &amp; Clima</h2>
      <p class="descripcion-seccion">
        Detalles clave para que tu estadía en la Ciudad Blanca y tu velada bajo las estrellas sean inolvidables.
      </p>
    </div>

    <!-- Bloque de 3 tarjetas de sugerencias principales -->
    <div class="recomendaciones-grid">
      {weddingRecommendations.map((rec, idx) => (
        <article class={`rec-card revelar ${idx > 0 ? `revelar--retraso-${idx}` : ''}`}>
          <div class="rec__icono-box">
            {rec.iconName === 'map-pin' && <MapPinIcon size={24} />}
            {rec.iconName === 'sparkles' && <SparklesIcon size={24} />}
            {rec.iconName === 'clock' && <ClockIcon size={24} />}
          </div>
          <h3 class="rec__titulo">{rec.title}</h3>
          <p class="rec__desc">{rec.description}</p>
        </article>
      ))}
    </div>

    <!-- Fila especial: Widget de Clima Arequipa + Playlist Oficial Spotify -->
    <div class="extra-experiencia-grid revelar revelar--retraso-3">
      <WeatherCard />
      <SpotifyPlaylistCard />
    </div>
  </div>
</section>

<style>
  .recomendaciones-grid {
    display: grid;
    gap: 2rem;
    margin-bottom: 2.5rem;
  }

  @media (min-width: 768px) {
    .recomendaciones-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 2rem;
    }
  }

  .rec-card {
    background: rgba(27, 42, 74, 0.45);
    border: 1px solid var(--linea-suave);
    border-radius: var(--radio-md);
    padding: 2.25rem 1.85rem;
    text-align: center;
    box-shadow: var(--sombra-suave);
    transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .rec-card:hover {
    border-color: var(--dorado);
    transform: translateY(-6px);
    box-shadow: var(--sombra-hover);
  }

  .rec__icono-box {
    width: 3.5rem;
    height: 3.5rem;
    margin: 0 auto 1.25rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: rgba(11, 29, 58, 0.7);
    border: 1px solid var(--linea);
    color: var(--dorado);
    box-shadow: 0 0 15px rgba(212, 175, 55, 0.15);
  }

  .rec__titulo {
    font-size: clamp(1.65rem, 2.5vw, 1.95rem);
    color: #FFF2A8;
    margin-bottom: 0.75rem;
  }

  .rec__desc {
    font-size: 0.98rem;
    line-height: 1.68;
    color: var(--crema);
    opacity: 0.94;
    margin: 0;
  }

  /* Fila Clima & Spotify */
  .extra-experiencia-grid {
    display: grid;
    gap: 2rem;
  }

  @media (min-width: 900px) {
    .extra-experiencia-grid {
      grid-template-columns: 1.15fr 0.85fr;
      align-items: stretch;
    }
  }
</style>
