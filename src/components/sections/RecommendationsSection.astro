---
import { weddingRecommendations } from '../../data/recommendations';
import MapPinIcon from '../icons/MapPinIcon.astro';
import SparklesIcon from '../icons/SparklesIcon.astro';
import ClockIcon from '../icons/ClockIcon.astro';
import MusicIcon from '../icons/MusicIcon.astro';
---
<section class="seccion seccion-optimizada" id="recomendaciones">
  <div class="interior">
    <div class="seccion-header">
      <p class="kicker">Para que todo salga perfecto</p>
      <h2 class="titulo-seccion">Recomendaciones &amp; Clima</h2>
      <p class="descripcion-seccion">
        Detalles clave para que tu estadía en la Ciudad Blanca y tu velada bajo las estrellas sean inolvidables.
      </p>
    </div>

    <!-- Bloque de 3 tarjetas de sugerencias principales -->
    <div class="recomendaciones-grid">
      {weddingRecommendations.map((rec, idx) => (
        <article class={`rec-card revelar ${idx > 0 ? `revelar--retraso-${idx}` : ''}`}>
          <div class="rec__icono-box">
            {rec.iconName === 'map-pin' && <MapPinIcon size={24} />}
            {rec.iconName === 'sparkles' && <SparklesIcon size={24} />}
            {rec.iconName === 'clock' && <ClockIcon size={24} />}
          </div>
          <h3 class="rec__titulo">{rec.title}</h3>
          <p class="rec__desc">{rec.description}</p>
        </article>
      ))}
    </div>

    <!-- Fila especial: Widget de Clima Arequipa + Playlist Oficial Spotify -->
    <div class="extra-experiencia-grid revelar revelar--retraso-3">
      <!-- Tarjeta de Clima & Altitud -->
      <article class="clima-card">
        <div class="clima-card__header">
          <div class="clima-card__insignia">
            <span class="clima-icon">🌋</span>
            <span class="clima-lugar">Arequipa · 2,325 m s. n. m.</span>
          </div>
          <h3 class="clima-card__titulo">Condiciones para el 12 de Junio</h3>
        </div>

        <div class="clima-metricas">
          <div class="metrica-chip">
            <span class="metrica-chip__icono">☀️</span>
            <div class="metrica-chip__datos">
              <span class="metrica-chip__temp">22°C</span>
              <span class="metrica-chip__etiqueta">Tarde soleada</span>
            </div>
          </div>

          <div class="metrica-chip">
            <span class="metrica-chip__icono">🌙</span>
            <div class="metrica-chip__datos">
              <span class="metrica-chip__temp">11°C</span>
              <span class="metrica-chip__etiqueta">Noche fresca</span>
            </div>
          </div>

          <div class="metrica-chip">
            <span class="metrica-chip__icono">✨</span>
            <div class="metrica-chip__datos">
              <span class="metrica-chip__temp">Cielo Limpio</span>
              <span class="metrica-chip__etiqueta">Vista estelar</span>
            </div>
          </div>
        </div>

        <p class="clima-card__nota">
          Al ser clima seco de altura, recomendamos mantenerte hidratado y traer un saco o estola elegante para la medianoche.
        </p>
      </article>

      <!-- Tarjeta de Playlist Spotify -->
      <article class="spotify-card">
        <div class="spotify-card__contenido">
          <div class="spotify-card__icono-box">
            <MusicIcon size={26} />
          </div>
          <span class="spotify-card__kicker">Banda sonora de nuestra historia</span>
          <h3 class="spotify-card__titulo">Playlist Oficial de la Boda</h3>
          <p class="spotify-card__desc">
            Siente la magia antes del gran día con las canciones que marcaron nuestro camino y los temas que bailaremos bajo la luna.
          </p>

          <a
            href="https://open.spotify.com"
            target="_blank"
            rel="noopener noreferrer"
            class="boton boton-dorado spotify-boton"
            id="btn-spotify-playlist"
          >
            <svg class="spotify-svg" viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
              <path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm5.502 17.308a.749.749 0 0 1-1.028.249c-2.812-1.718-6.353-2.107-10.523-1.155a.75.75 0 0 1-.336-1.462c4.562-1.042 8.49-.607 11.64 1.34a.75.75 0 0 1 .247 1.028zm1.467-3.264a.936.936 0 0 1-1.288.309c-3.218-1.978-8.125-2.55-11.93-1.395a.937.937 0 1 1-.548-1.792c4.349-1.32 9.775-.683 13.457 1.58a.938.938 0 0 1 .309 1.298zm.126-3.398c-3.858-2.29-10.222-2.502-13.886-1.39a1.125 1.125 0 0 1-.65-2.153c4.214-1.28 11.238-1.031 15.688 1.611a1.125 1.125 0 1 1-1.152 1.932z"/>
            </svg>
            <span>Escuchar en Spotify</span>
          </a>
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  .recomendaciones-grid {
    display: grid;
    gap: 2rem;
    margin-bottom: 2.5rem;
  }

  @media (min-width: 768px) {
    .recomendaciones-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 2rem;
    }
  }

  .rec-card {
    background: rgba(27, 42, 74, 0.45);
    border: 1px solid var(--linea-suave);
    border-radius: var(--radio-md);
    padding: 2.25rem 1.75rem;
    text-align: center;
    box-shadow: var(--sombra-suave);
    transition: var(--transicion);
  }

  .rec-card:hover {
    border-color: var(--dorado);
    transform: translateY(-4px);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
  }

  .rec__icono-box {
    width: 3.5rem;
    height: 3.5rem;
    margin: 0 auto 1.25rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: rgba(11, 29, 58, 0.7);
    border: 1px solid var(--linea);
    color: var(--dorado);
    box-shadow: 0 0 15px rgba(212, 175, 55, 0.15);
  }

  .rec__titulo {
    font-size: 1.6rem;
    color: var(--dorado);
    margin-bottom: 0.75rem;
  }

  .rec__desc {
    font-size: 0.95rem;
    line-height: 1.65;
    color: var(--crema);
    opacity: 0.9;
    margin: 0;
  }

  /* Fila Clima & Spotify */
  .extra-experiencia-grid {
    display: grid;
    gap: 2rem;
  }

  @media (min-width: 900px) {
    .extra-experiencia-grid {
      grid-template-columns: 1.15fr 0.85fr;
      align-items: stretch;
    }
  }

  /* Tarjeta Clima */
  .clima-card {
    background: linear-gradient(135deg, rgba(27, 42, 74, 0.65) 0%, rgba(11, 29, 58, 0.75) 100%);
    border: 1px solid rgba(212, 175, 55, 0.35);
    border-radius: var(--radio-lg);
    padding: 2rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    box-shadow: var(--sombra-suave);
  }

  .clima-card__insignia {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--dorado);
    margin-bottom: 0.5rem;
  }

  .clima-card__titulo {
    font-family: var(--titulo);
    font-size: 1.8rem;
    color: #FFF6D6;
    margin: 0 0 1.25rem;
  }

  .clima-metricas {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(110px, 1fr));
    gap: 0.85rem;
    margin-bottom: 1.25rem;
  }

  .metrica-chip {
    background: rgba(7, 16, 32, 0.65);
    border: 1px solid rgba(212, 175, 55, 0.25);
    border-radius: var(--radio-md);
    padding: 0.85rem 0.6rem;
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .metrica-chip__icono {
    font-size: 1.4rem;
  }

  .metrica-chip__datos {
    display: flex;
    flex-direction: column;
  }

  .metrica-chip__temp {
    font-family: var(--titulo);
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--dorado);
    line-height: 1.1;
  }

  .metrica-chip__etiqueta {
    font-size: 0.72rem;
    color: var(--plata);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .clima-card__nota {
    font-size: 0.88rem;
    color: var(--crema);
    opacity: 0.85;
    margin: 0;
    line-height: 1.5;
    border-top: 1px dashed rgba(212, 175, 55, 0.2);
    padding-top: 0.85rem;
  }

  /* Tarjeta Spotify */
  .spotify-card {
    background: radial-gradient(circle at 80% 20%, rgba(30, 215, 96, 0.08) 0%, rgba(11, 29, 58, 0.75) 70%);
    border: 1px solid rgba(212, 175, 55, 0.35);
    border-radius: var(--radio-lg);
    padding: 2rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    box-shadow: var(--sombra-suave);
    position: relative;
    overflow: hidden;
  }

  .spotify-card__icono-box {
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 50%;
    background: rgba(29, 185, 84, 0.15);
    border: 1px solid rgba(29, 185, 84, 0.4);
    color: #1ED760;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 0.85rem;
    box-shadow: 0 0 20px rgba(29, 185, 84, 0.2);
  }

  .spotify-card__kicker {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--plata);
    display: block;
    margin-bottom: 0.35rem;
  }

  .spotify-card__titulo {
    font-family: var(--titulo);
    font-size: 1.8rem;
    color: var(--dorado);
    margin: 0 0 0.6rem;
  }

  .spotify-card__desc {
    font-size: 0.88rem;
    line-height: 1.5;
    color: var(--crema);
    opacity: 0.9;
    max-width: 20rem;
    margin: 0 auto 1.35rem;
  }

  .spotify-boton {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.75rem 1.6rem;
    font-size: 0.92rem;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.3), 0 0 15px rgba(212, 175, 55, 0.3);
  }

  .spotify-svg {
    fill: currentColor;
  }
</style>
