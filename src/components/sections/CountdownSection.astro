---
import ClockIcon from '../icons/ClockIcon.astro';
import ShootingStars from '../ui/ShootingStars.astro';
import CountdownClock from '../ui/CountdownClock.astro';
---
<section class="seccion cielo" id="cuenta-seccion">
  <ShootingStars />

  <div class="interior">
    <div class="seccion-header revelar">
      <div class="cuenta__badge">
        <ClockIcon size={18} class="text-[#D4AF37]" />
        <span>Tiempo Hacia el Enlace</span>
      </div>
      <p class="kicker">Cada noche falta una menos</p>
      <h2 class="titulo-seccion brillo-dorado">Nos vemos pronto</h2>
      <p class="descripcion-seccion">
        Contando cada segundo hasta encontrarnos bajo el cielo estrellado de Arequipa.
      </p>
    </div>

    <CountdownClock />
  </div>
</section>

<style>
  .cuenta__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 1rem;
    font-size: 0.82rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--dorado);
    background: rgba(212, 175, 55, 0.1);
    border: 1px solid var(--linea);
    border-radius: var(--radio-full);
    margin-bottom: 0.9rem;
  }
</style>
