---
import { weddingFaqs } from '../../data/faq';
import ChevronDownIcon from '../icons/ChevronDownIcon.astro';
import StarIcon from '../icons/StarIcon.astro';
---
<section class="seccion seccion--profundo seccion-optimizada" id="faq">
  <div class="interior">
    <div class="seccion-header">
      <div class="faq__badge">
        <StarIcon size={16} class="text-[#D4AF37]" />
        <span>Claridad &amp; Detalles</span>
      </div>
      <p class="kicker">Antes de que lo preguntes</p>
      <h2 class="titulo-seccion">Preguntas frecuentes</h2>
      <p class="descripcion-seccion">
        Todo lo que necesitas saber para prepararte con tranquilidad y disfrutar de principio a fin.
      </p>
    </div>

    <!-- Lista de Acordeones de Lujo -->
    <div class="faq-lista">
      {weddingFaqs.map((item, idx) => (
        <details class="faq-item revelar" style={`animation-delay: ${idx * 60}ms;`}>
          <summary class="faq-pregunta">
            <div class="faq-pregunta__left">
              <span class="faq-punto-estrella" aria-hidden="true">★</span>
              <span class="faq-pregunta__texto">{item.question}</span>
            </div>
            <span class="faq-chevron">
              <ChevronDownIcon size={18} />
            </span>
          </summary>
          <div class="faq-respuesta">
            <p>{item.answer}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 1rem;
    font-size: 0.82rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--dorado);
    background: rgba(212, 175, 55, 0.1);
    border: 1px solid var(--linea);
    border-radius: var(--radio-full);
    margin-bottom: 0.9rem;
  }

  .faq-lista {
    max-width: 48rem;
    margin: 2rem auto 0;
    display: grid;
    gap: 0.85rem;
  }

  .faq-item {
    background: rgba(11, 29, 58, 0.45);
    border: 1px solid var(--linea-suave);
    border-radius: var(--radio-md);
    overflow: hidden;
    transition: all 0.25s ease;
  }

  .faq-item:hover {
    background: rgba(27, 42, 74, 0.55);
    border-color: rgba(212, 175, 55, 0.4);
  }

  .faq-item[open] {
    background: rgba(27, 42, 74, 0.7);
    border-color: var(--dorado);
    box-shadow: 0 6px 25px rgba(0, 0, 0, 0.35), 0 0 15px rgba(212, 175, 55, 0.15);
  }

  .faq-pregunta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.25rem 1.4rem;
    font-family: var(--titulo);
    font-size: clamp(1.15rem, 2.5vw, 1.4rem);
    font-weight: 500;
    color: var(--crema);
    cursor: pointer;
    list-style: none;
    user-select: none;
    transition: color 0.2s ease;
  }

  .faq-item[open] .faq-pregunta {
    color: var(--dorado);
  }

  .faq-pregunta::-webkit-details-marker {
    display: none;
  }

  .faq-pregunta__left {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex: 1;
    padding-right: 1rem;
  }

  .faq-punto-estrella {
    font-size: 0.75rem;
    color: var(--dorado);
    opacity: 0.7;
    flex-shrink: 0;
  }

  .faq-item[open] .faq-punto-estrella {
    opacity: 1;
    text-shadow: 0 0 8px var(--dorado);
  }

  .faq-pregunta__texto {
    line-height: 1.35;
  }

  .faq-chevron {
    color: var(--dorado);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .faq-item[open] .faq-chevron {
    transform: rotate(180deg);
  }

  .faq-respuesta {
    padding: 0 1.4rem 1.35rem 2.75rem;
    color: var(--crema);
    opacity: 0.92;
    font-size: 0.95rem;
    line-height: 1.65;
    animation: fadeIn 0.25s ease-out;
  }

  .faq-respuesta p {
    margin: 0;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
    to {
      opacity: 0.92;
      transform: translateY(0);
    }
  }
</style>
