---
import { storyMilestones } from '../../data/story';
import BookOpenIcon from '../icons/BookOpenIcon.astro';
import TimelineMilestoneItem from '../ui/TimelineMilestoneItem.astro';
---
<section class="seccion seccion--alterna" id="historia">
  <div class="interior">
    <div class="seccion-header">
      <div class="historia__badge">
        <BookOpenIcon size={18} class="text-[#D4AF37]" />
        <span>Nuestra Travesía</span>
      </div>
      <p class="kicker">De la biblioteca a las estrellas</p>
      <h2 class="titulo-seccion">Nuestra historia</h2>
      <p class="descripcion-seccion">
        Cada capítulo que nos trajo hasta esta noche bajo el firmamento de Arequipa.
      </p>
    </div>

    <!-- Contenedor de la línea de tiempo con eje estelar central -->
    <div class="timeline-contenedor">
      <!-- Eje vertical estelar (constelación) -->
      <div class="timeline-eje" aria-hidden="true"></div>

      <div class="timeline-hitos">
        {storyMilestones.map((momento, idx) => (
          <TimelineMilestoneItem
            momento={momento}
            idx={idx}
            esFinal={idx === storyMilestones.length - 1}
          />
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .historia__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 1rem;
    font-size: 0.82rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--dorado);
    background: rgba(212, 175, 55, 0.1);
    border: 1px solid var(--linea);
    border-radius: var(--radio-full);
    margin-bottom: 0.9rem;
  }

  /* Contenedor con Eje Central */
  .timeline-contenedor {
    position: relative;
    max-width: 68rem;
    margin: 2rem auto 0;
    padding: 1rem 0;
  }

  /* Eje estelar vertical */
  .timeline-eje {
    position: absolute;
    top: 2rem;
    bottom: 3rem;
    left: 1.5rem;
    width: 2px;
    background: linear-gradient(
      180deg,
      transparent 0%,
      rgba(212, 175, 55, 0.7) 10%,
      rgba(212, 175, 55, 0.7) 90%,
      transparent 100%
    );
    box-shadow: 0 0 12px rgba(212, 175, 55, 0.4);
    pointer-events: none;
    z-index: 1;
  }

  @media (min-width: 900px) {
    .timeline-eje {
      left: 50%;
      transform: translateX(-50%);
    }
  }

  .timeline-hitos {
    display: grid;
    gap: clamp(3.5rem, 6vw, 5.5rem);
  }
</style>
