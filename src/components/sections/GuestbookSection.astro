---
import SparklesIcon from '../icons/SparklesIcon.astro';
import HeartIcon from '../icons/HeartIcon.astro';
import StarIcon from '../icons/StarIcon.astro';
---

<section class="seccion seccion--profundo seccion-optimizada" id="libro-firmas">
  <div class="interior">
    <div class="seccion-header">
      <div class="firmas__badge">
        <SparklesIcon size={18} class="text-[#D4AF37]" />
        <span>Libro de Firmas</span>
      </div>
      <p class="kicker">Palabras desde el corazón</p>
      <h2 class="titulo-seccion brillo-dorado">Muro de buenos deseos</h2>
      <p class="descripcion-seccion">
        Deja una bendición o dedicatoria para Daniela &amp; Rodrigo. Tus palabras acompañarán a los novios en su viaje bajo el firmamento.
      </p>
    </div>

    <!-- Layout: Formulario de Dedicatoria a la Izquierda / Mensajes Estelares a la Derecha -->
    <div class="firmas-layout">
      <!-- Tarjeta Formulario -->
      <div class="firmas-form-card revelar">
        <div class="firmas-form__header">
          <div class="firmas-form__icono">
            <HeartIcon size={20} fill={true} class="text-[#D4AF37]" />
          </div>
          <h3 class="firmas-form__titulo">Dedica unas palabras</h3>
          <p class="firmas-form__sub">Tu dedicatoria se sumará al firmamento digital de la boda.</p>
        </div>

        <form id="form-guestbook" class="firmas-form">
          <div class="campo">
            <label for="autor-deseo">Tu nombre o Familia</label>
            <input
              type="text"
              id="autor-deseo"
              name="autor"
              required
              maxlength="60"
              placeholder="Ej. Familia Valdivia / Carlos y Andrea"
              class="input-estelar"
            />
          </div>

          <div class="campo">
            <label for="texto-deseo">Tu mensaje para los novios</label>
            <textarea
              id="texto-deseo"
              name="mensaje"
              rows="4"
              required
              maxlength="400"
              placeholder="Escribe aquí tu dedicatoria, consejo o buenos deseos..."
              class="input-estelar textarea-estelar"
            ></textarea>
          </div>

          <button type="submit" class="boton boton--lleno firmas-submit-btn" id="btn-enviar-deseo">
            <StarIcon size={16} />
            <span>Publicar mi dedicatoria</span>
          </button>
          
          <div id="guestbook-feedback" class="firmas-feedback" hidden>
            ¡Gracias por tus hermosas palabras! Tu mensaje ya brilla en el muro.
          </div>
        </form>
      </div>

      <!-- Muro de Mensajes Dinámicos -->
      <div class="firmas-mensajes-col revelar revelar--retraso-1">
        <div class="mensajes-header">
          <span class="mensajes-conteo" id="mensajes-contador">Deseos para los novios</span>
          <span class="mensajes-luz-badge">✧ En vivo</span>
        </div>

        <div id="muro-deseos-lista" class="muro-deseos-grid" role="feed" aria-label="Dedicatorias de los invitados">
          <!-- Se renderizan automáticamente vía JS con almacenamiento local + pre-cargados -->
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .firmas__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 1rem;
    font-size: 0.82rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--dorado);
    background: rgba(212, 175, 55, 0.1);
    border: 1px solid var(--linea);
    border-radius: var(--radio-full);
    margin-bottom: 0.9rem;
  }

  .firmas-layout {
    display: grid;
    gap: 2.5rem;
    align-items: start;
  }

  @media (min-width: 900px) {
    .firmas-layout {
      grid-template-columns: 0.85fr 1.15fr;
      gap: 3.5rem;
    }
  }

  /* Tarjeta de Formulario */
  .firmas-form-card {
    background: radial-gradient(circle at top right, rgba(74, 59, 107, 0.3) 0%, rgba(11, 29, 58, 0.85) 100%);
    border: 1px solid var(--linea);
    border-radius: var(--radio-lg);
    padding: clamp(1.75rem, 3.5vw, 2.5rem);
    box-shadow: 0 16px 45px rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .firmas-form-card:hover {
    border-color: rgba(212, 175, 55, 0.65);
    box-shadow: 0 20px 55px rgba(0, 0, 0, 0.6), 0 0 25px rgba(212, 175, 55, 0.2);
  }

  .firmas-form__header {
    text-align: center;
    margin-bottom: 1.75rem;
  }

  .firmas-form__icono {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background: rgba(7, 16, 32, 0.7);
    border: 1px solid var(--linea);
    margin-bottom: 0.75rem;
    box-shadow: 0 0 15px rgba(212, 175, 55, 0.2);
  }

  .firmas-form__titulo {
    font-family: var(--titulo);
    font-size: clamp(1.65rem, 3vw, 2rem);
    color: #FFF2A8;
    margin: 0 0 0.35rem;
  }

  .firmas-form__sub {
    font-size: 0.9rem;
    color: var(--plata);
    margin: 0;
    line-height: 1.5;
  }

  .firmas-form {
    display: grid;
    gap: 1.35rem;
  }

  .campo {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    text-align: left;
  }

  .campo label {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--crema);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .input-estelar {
    width: 100%;
    padding: 0.85rem 1.15rem;
    background: rgba(7, 16, 32, 0.75);
    border: 1px solid var(--linea-suave);
    border-radius: var(--radio-sm);
    color: #FFF6D6;
    font-family: var(--cuerpo);
    font-size: 0.95rem;
    transition: all 0.25s ease;
  }

  .input-estelar:focus {
    outline: none;
    border-color: var(--dorado);
    box-shadow: 0 0 15px rgba(212, 175, 55, 0.35);
    background: rgba(11, 29, 58, 0.85);
  }

  .input-estelar::placeholder {
    color: var(--plata);
    opacity: 0.55;
  }

  .textarea-estelar {
    resize: vertical;
    min-height: 5.5rem;
    line-height: 1.6;
  }

  .firmas-submit-btn {
    width: 100%;
    margin-top: 0.5rem;
  }

  .firmas-feedback {
    background: rgba(45, 212, 191, 0.12);
    border: 1px solid rgba(45, 212, 191, 0.4);
    color: #5EEAD4;
    padding: 0.75rem 1rem;
    border-radius: var(--radio-sm);
    font-size: 0.88rem;
    text-align: center;
    animation: fadeIn 0.3s ease;
  }

  /* Columna de Mensajes */
  .firmas-mensajes-col {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .mensajes-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--linea-suave);
  }

  .mensajes-conteo {
    font-family: var(--titulo);
    font-size: 1.35rem;
    color: var(--dorado);
    font-weight: 500;
  }

  .mensajes-luz-badge {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #34D399;
    font-weight: 600;
  }

  .muro-deseos-grid {
    display: grid;
    gap: 1.25rem;
    max-height: 38rem;
    overflow-y: auto;
    padding-right: 0.35rem;
  }

  /* Scrollbar custom para el muro */
  .muro-deseos-grid::-webkit-scrollbar {
    width: 6px;
  }
  .muro-deseos-grid::-webkit-scrollbar-track {
    background: rgba(7, 16, 32, 0.4);
    border-radius: 999px;
  }
  .muro-deseos-grid::-webkit-scrollbar-thumb {
    background: rgba(212, 175, 55, 0.3);
    border-radius: 999px;
  }
  .muro-deseos-grid::-webkit-scrollbar-thumb:hover {
    background: var(--dorado);
  }

  :global(.deseo-card) {
    background: rgba(27, 42, 74, 0.45);
    border: 1px solid var(--linea-suave);
    border-radius: var(--radio-md);
    padding: 1.35rem 1.45rem;
    box-shadow: var(--sombra-suave);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    position: relative;
  }

  :global(.deseo-card:hover) {
    transform: translateY(-4px);
    border-color: var(--dorado);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.45), 0 0 15px rgba(212, 175, 55, 0.2);
  }

  :global(.deseo-card--nuevo) {
    animation: resplandor-nuevo 1s ease-out;
  }

  @keyframes resplandor-nuevo {
    0% { transform: scale(0.96); border-color: #FFE58F; box-shadow: 0 0 30px rgba(212, 175, 55, 0.6); }
    100% { transform: scale(1); }
  }

  :global(.deseo-card__top) {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
  }

  :global(.deseo-autor) {
    font-family: var(--titulo);
    font-size: 1.25rem;
    font-weight: 600;
    color: #FFF4D0;
  }

  :global(.deseo-fecha) {
    font-size: 0.72rem;
    color: var(--plata);
    letter-spacing: 0.05em;
    opacity: 0.8;
  }

  :global(.deseo-texto) {
    font-size: 0.94rem;
    line-height: 1.62;
    color: var(--crema);
    opacity: 0.94;
    margin: 0;
    font-style: italic;
  }

  :global(.deseo-card__pie) {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    margin-top: 0.25rem;
  }

  :global(.btn-reaccion) {
    background: transparent;
    border: none;
    color: var(--dorado);
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.78rem;
    cursor: pointer;
    padding: 0.25rem 0.5rem;
    border-radius: var(--radio-full);
    transition: all 0.2s ease;
  }

  :global(.btn-reaccion:hover) {
    background: rgba(212, 175, 55, 0.15);
    transform: scale(1.08);
  }
</style>

<script>
  import { initialGuestbookWishes, type Deseo } from '../../data/guestbook';

  function setupGuestbook() {
    const contenedor = document.getElementById('muro-deseos-lista');
    const form = document.getElementById('form-guestbook') as HTMLFormElement | null;
    const feedback = document.getElementById('guestbook-feedback');
    const inputAutor = document.getElementById('autor-deseo') as HTMLInputElement | null;
    const inputTexto = document.getElementById('texto-deseo') as HTMLTextAreaElement | null;

    if (!contenedor || !form) return;

    // Cargar deseos desde localStorage combinados con los iniciales
    function obtenerDeseos(): Deseo[] {
      try {
        const guardados = localStorage.getItem('guestbook_deseos');
        if (guardados) {
          const parsed = JSON.parse(guardados);
          if (Array.isArray(parsed) && parsed.length > 0) {
            return parsed;
          }
        }
      } catch {}
      return initialGuestbookWishes;
    }

    function guardarDeseos(deseos: Deseo[]) {
      try {
        localStorage.setItem('guestbook_deseos', JSON.stringify(deseos));
      } catch {}
    }

    function renderizarDeseos(nuevoId?: string) {
      if (!contenedor) return;
      const deseos = obtenerDeseos();
      contenedor.innerHTML = '';

      deseos.forEach(d => {
        const card = document.createElement('article');
        card.className = `deseo-card ${nuevoId === d.id ? 'deseo-card--nuevo' : ''}`;
        card.innerHTML = `
          <div class="deseo-card__top">
            <strong class="deseo-autor">${escapeHtml(d.autor)}</strong>
            <span class="deseo-fecha">${escapeHtml(d.fecha)}</span>
          </div>
          <p class="deseo-texto">«${escapeHtml(d.texto)}»</p>
          <div class="deseo-card__pie">
            <button type="button" class="btn-reaccion" data-like-id="${d.id}" aria-label="Dar cariño a este mensaje">
              <svg class="reaccion-icon-svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>
              <span class="reaccion-count">${d.likes}</span>
            </button>
          </div>
        `;
        contenedor.appendChild(card);
      });

      // Listeners de likes
      contenedor.querySelectorAll('.btn-reaccion').forEach(btn => {
        btn.addEventListener('click', () => {
          const id = btn.getAttribute('data-like-id');
          if (!id) return;
          const deseos = obtenerDeseos();
          const target = deseos.find(item => item.id === id);
          if (target) {
            target.likes += 1;
            guardarDeseos(deseos);
            const countEl = btn.querySelector('.reaccion-count');
            const svgEl = btn.querySelector('.reaccion-icon-svg');
            if (countEl) countEl.textContent = target.likes.toString();
            if (svgEl) {
              svgEl.setAttribute('fill', '#D4AF37');
              svgEl.setAttribute('stroke', '#D4AF37');
            }
          }
        });
      });
    }

    function escapeHtml(str: string): string {
      const div = document.createElement('div');
      div.textContent = str;
      return div.innerHTML;
    }

    // Envío del formulario
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      if (!inputAutor || !inputTexto) return;

      const autor = inputAutor.value.trim();
      const texto = inputTexto.value.trim();
      if (!autor || !texto) return;

      const nuevoDeseo: Deseo = {
        id: 'd_' + Date.now(),
        autor,
        texto,
        fecha: 'Justo ahora',
        likes: 1
      };

      const deseos = obtenerDeseos();
      deseos.unshift(nuevoDeseo);
      guardarDeseos(deseos);

      // Renderizar con destaque
      renderizarDeseos(nuevoDeseo.id);

      // Limpiar y dar feedback
      form.reset();
      if (feedback) {
        feedback.hidden = false;
        setTimeout(() => {
          feedback.hidden = true;
        }, 4000);
      }
    });

    renderizarDeseos();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupGuestbook);
  } else {
    setupGuestbook();
  }
</script>
