---
import { weddingData } from '../../data/wedding';
import ConstellationIcon from '../icons/ConstellationIcon.astro';
import WhatsAppIcon from '../icons/WhatsAppIcon.astro';
import MailIcon from '../icons/MailIcon.astro';
---
<section class="seccion" id="contacto">
  <div class="interior contacto-box">
    <div class="contacto__adorno">
      <ConstellationIcon class="w-48 h-auto mx-auto mb-5 text-[#D4AF37]" />
    </div>

    <p class="kicker">Estamos para acompañarte</p>
    <h2 class="titulo-seccion">¿Dudas o consultas? Escríbenos</h2>
    <p class="contacto__desc">
      Estaremos encantados de resolver cualquier inquietud sobre la ceremonia, el traslado o tu estancia en Arequipa.
    </p>

    <div class="contacto__botones">
      <a
        class="boton boton--lleno"
        target="_blank"
        rel="noopener noreferrer"
        href={`https://wa.me/${weddingData.whatsappNumber}?text=Hola%20Daniela%20y%20Rodrigo%2C%20tengo%20una%20consulta%20sobre%20la%20boda.`}
      >
        <WhatsAppIcon size={18} />
        <span>Escribir por WhatsApp ({weddingData.whatsappDisplay})</span>
      </a>

      <a class="boton" href={`mailto:${weddingData.contactEmail}`}>
        <MailIcon size={18} />
        <span>{weddingData.contactEmail}</span>
      </a>
    </div>
  </div>
</section>

<style>
  .contacto-box {
    max-width: 40rem;
    margin: 0 auto;
    text-align: center;
  }

  .contacto__desc {
    font-size: 1.05rem;
    color: var(--crema);
    opacity: 0.9;
    margin-bottom: 2rem;
    line-height: 1.6;
  }

  .contacto__botones {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.25rem;
  }
</style>
