---
import { arequipaGuideCategories, arequipaGuideBanner } from '../../data/arequipaGuide';
import SparklesIcon from '../icons/SparklesIcon.astro';
import MapPinIcon from '../icons/MapPinIcon.astro';
import UtensilsIcon from '../icons/UtensilsIcon.astro';
import LandmarkIcon from '../icons/LandmarkIcon.astro';
import MountainIcon from '../icons/MountainIcon.astro';
---

<section class="seccion seccion--profundo seccion-optimizada" id="guia-arequipa">
  <div class="interior">
    <div class="seccion-header">
      <div class="guia__badge">
        <SparklesIcon size={18} class="text-[#D4AF37]" />
        <span>Ruta de la Ciudad Blanca</span>
      </div>
      <p class="kicker">Para nuestros invitados viajeros</p>
      <h2 class="titulo-seccion brillo-dorado">Mini-Guía de Arequipa</h2>
      <p class="descripcion-seccion">
        Seleccionamos con especial cariño los rincones, sabores y secretos que más amamos de nuestra tierra para que vivas una experiencia memorable.
      </p>
    </div>

    <!-- 3 Pilares de la Guía: Gastronomía, Rutas y Altitud/Bienestar -->
    <div class="guia-grid">
      {arequipaGuideCategories.map((cat, idx) => (
        <article class={`guia-card revelar ${idx > 0 ? `revelar--retraso-${idx}` : ''}`}>
          <div class="guia-card__top">
            <div class="guia-card__icono">
              {cat.iconType === 'utensils' && <UtensilsIcon size={22} class="text-[#D4AF37]" />}
              {cat.iconType === 'landmark' && <LandmarkIcon size={22} class="text-[#D4AF37]" />}
              {cat.iconType === 'mountain' && <MountainIcon size={22} class="text-[#D4AF37]" />}
            </div>
            <span class="guia-card__tag">{cat.tag}</span>
          </div>
          <h3 class="guia-card__titulo">{cat.title}</h3>
          <p class="guia-card__intro">{cat.intro}</p>
          <ul class="guia-lista">
            {cat.items.map((item) => (
              <li>
                <strong>{item.bold}:</strong> {item.text}
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>

    <!-- Banner complementario con enlace a mapas -->
    <div class="guia-banner revelar">
      <div class="guia-banner__info">
        <div class="guia-banner__pin">
          <MapPinIcon size={20} class="text-[#D4AF37]" />
        </div>
        <div>
          <h4 class="guia-banner__titulo">{arequipaGuideBanner.title}</h4>
          <p class="guia-banner__desc">{arequipaGuideBanner.description}</p>
        </div>
      </div>
      <a
        href={arequipaGuideBanner.buttonHref}
        class="boton boton--linea guia-banner__btn"
      >
        <span>{arequipaGuideBanner.buttonText}</span>
      </a>
    </div>
  </div>
</section>

<style>
  .guia__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 1rem;
    font-size: 0.82rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--dorado);
    background: rgba(212, 175, 55, 0.1);
    border: 1px solid var(--linea);
    border-radius: var(--radio-full);
    margin-bottom: 0.9rem;
  }

  .guia-grid {
    display: grid;
    gap: 2rem;
    margin-bottom: 2.75rem;
  }

  @media (min-width: 900px) {
    .guia-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .guia-card {
    background: rgba(27, 42, 74, 0.45);
    border: 1px solid var(--linea-suave);
    border-radius: var(--radio-md);
    padding: 2.25rem 1.85rem;
    display: flex;
    flex-direction: column;
    box-shadow: var(--sombra-suave);
    transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    position: relative;
  }

  .guia-card:hover {
    transform: translateY(-6px);
    border-color: var(--dorado);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.5), 0 0 20px rgba(212, 175, 55, 0.18);
  }

  .guia-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.25rem;
  }

  .guia-card__icono {
    font-size: 2rem;
    line-height: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 50%;
    background: rgba(7, 16, 32, 0.7);
    border: 1px solid var(--linea-suave);
    box-shadow: 0 0 15px rgba(212, 175, 55, 0.15);
  }

  .guia-card__tag {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--dorado);
    font-weight: 600;
  }

  .guia-card__titulo {
    font-family: var(--titulo);
    font-size: clamp(1.6rem, 2.5vw, 1.85rem);
    color: #FFF2A8;
    margin: 0 0 0.85rem;
    line-height: 1.25;
  }

  .guia-card__intro {
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--crema);
    opacity: 0.9;
    margin: 0 0 1.25rem;
  }

  .guia-lista {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    flex: 1;
    border-top: 1px dashed rgba(212, 175, 55, 0.25);
    padding-top: 1.25rem;
  }

  .guia-lista li {
    font-size: 0.88rem;
    line-height: 1.55;
    color: #F8F4EC;
    opacity: 0.92;
    position: relative;
    padding-left: 1.15rem;
  }

  .guia-lista li::before {
    content: "✧";
    position: absolute;
    left: 0;
    top: 0;
    color: var(--dorado);
    font-size: 0.8rem;
  }

  .guia-lista strong {
    color: #FFF6D6;
    font-weight: 600;
  }

  /* Banner Inferior */
  .guia-banner {
    background: radial-gradient(circle at top left, rgba(74, 59, 107, 0.3) 0%, rgba(11, 29, 58, 0.7) 100%);
    border: 1px solid var(--linea);
    border-radius: var(--radio-md);
    padding: 1.5rem 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    align-items: center;
    justify-content: space-between;
    box-shadow: var(--sombra-suave);
  }

  @media (min-width: 768px) {
    .guia-banner {
      flex-direction: row;
    }
  }

  .guia-banner__info {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .guia-banner__pin {
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background: rgba(7, 16, 32, 0.75);
    border: 1px solid var(--linea-suave);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    box-shadow: 0 0 12px rgba(212, 175, 55, 0.2);
  }

  .guia-banner__titulo {
    font-family: var(--titulo);
    font-size: 1.25rem;
    color: #FFF6D6;
    margin: 0 0 0.25rem;
  }

  .guia-banner__desc {
    font-size: 0.88rem;
    color: var(--plata);
    margin: 0;
    line-height: 1.45;
  }

  .guia-banner__btn {
    white-space: nowrap;
    padding: 0.65rem 1.4rem;
    font-size: 0.88rem;
    flex-shrink: 0;
  }
</style>
