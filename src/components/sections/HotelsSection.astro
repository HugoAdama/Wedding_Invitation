---
import { recommendedHotels, hotelNotice } from '../../data/hotels';
import BedIcon from '../icons/BedIcon.astro';
import SparklesIcon from '../icons/SparklesIcon.astro';
import HotelCard from '../ui/HotelCard.astro';
---
<section class="seccion seccion--profundo seccion-optimizada" id="hospedaje">
  <div class="interior">
    <div class="seccion-header">
      <div class="hospedaje__badge">
        <BedIcon size={18} class="text-[#D4AF37]" />
        <span>Estadía en Arequipa</span>
      </div>
      <p class="kicker">Si vienes de fuera</p>
      <h2 class="titulo-seccion">Hospedaje sugerido</h2>
      <p class="descripcion-seccion">
        Opciones seleccionadas por cercanía a la hacienda y fácil acceso a los encantos de la Ciudad Blanca.
      </p>
    </div>

    <!-- Grid de 3 Columnas de Hoteles -->
    <div class="hoteles-grid">
      {recommendedHotels.map((hotel, idx) => (
        <HotelCard hotel={hotel} idx={idx} />
      ))}
    </div>

    <!-- Aviso de descuento y reservas -->
    <div class="hospedaje__aviso-card revelar">
      <div class="aviso-card__icono">
        <SparklesIcon size={20} class="text-[#D4AF37]" />
      </div>
      <div class="aviso-card__texto">
        <strong>Tarifas y reservas con anticipación</strong>
        <p>{hotelNotice}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .hospedaje__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 1rem;
    font-size: 0.82rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--dorado);
    background: rgba(212, 175, 55, 0.1);
    border: 1px solid var(--linea);
    border-radius: var(--radio-full);
    margin-bottom: 0.9rem;
  }

  /* Grid de 3 Columnas */
  .hoteles-grid {
    display: grid;
    gap: 1.75rem;
    margin-bottom: 3rem;
  }

  @media (min-width: 680px) {
    .hoteles-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 980px) {
    .hoteles-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 2rem;
    }
  }

  /* Tarjeta de Aviso Inferior */
  .hospedaje__aviso-card {
    max-width: 50rem;
    margin: 0 auto;
    padding: 1.35rem 1.75rem;
    background: radial-gradient(circle at top left, rgba(74, 59, 107, 0.3) 0%, rgba(11, 29, 58, 0.6) 100%);
    border: 1px solid var(--linea);
    border-radius: var(--radio-md);
    box-shadow: var(--sombra-suave);
    display: flex;
    align-items: flex-start;
    gap: 1.25rem;
  }

  .aviso-card__icono {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: rgba(7, 16, 32, 0.7);
    border: 1px solid var(--linea-suave);
    flex-shrink: 0;
    margin-top: 0.15rem;
  }

  .aviso-card__texto {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .aviso-card__texto strong {
    font-size: 0.95rem;
    color: var(--dorado);
  }

  .aviso-card__texto p {
    font-size: 0.88rem;
    color: var(--crema);
    opacity: 0.9;
    line-height: 1.55;
    margin: 0;
  }
</style>
