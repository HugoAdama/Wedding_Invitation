---
import { weddingData } from '../../data/wedding';
import StarIcon from '../icons/StarIcon.astro';
---
<footer class="cierre">
  <div class="cierre__luna pulso-lunar" aria-hidden="true"></div>
  <p class="cierre__gracias">Gracias por ser parte fundamental de nuestra historia</p>
  <h2 class="cierre__nombres brillo-dorado">{weddingData.brideName} &amp; {weddingData.groomName}</h2>
  <p class="cierre__fecha-lugar">{weddingData.dateFormatted} · {weddingData.city}</p>

  <p class="cierre__hashtag">
    <StarIcon size={14} class="hashtag-star" />
    <span>{weddingData.hashtag}</span>
    <StarIcon size={14} class="hashtag-star" />
  </p>

  <div class="cierre__separador" aria-hidden="true">
    <span>✧</span>
    <span>✦</span>
    <span>✧</span>
  </div>

  <!-- Créditos de desarrollo con enlace al repositorio GitHub -->
  <div class="cierre__creditos">
    <a
      href="https://github.com/HugoAdama/Wedding_Invitation"
      target="_blank"
      rel="noopener noreferrer"
      class="creditos__badge"
      aria-label="Repositorio del proyecto en GitHub, desarrollado por Hugo Adama"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="github-icon" aria-hidden="true">
        <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/>
      </svg>
      <span>Desarrollado por <strong class="autor-nombre">Hugo Adama</strong></span>
    </a>

    <p class="creditos__leyenda">
      Boda de cielo estrellado · Arequipa, Perú · 2027
    </p>
  </div>
</footer>

<style>
  .cierre {
    padding: 5.5rem var(--lado) calc(4rem + env(safe-area-inset-bottom, 0px));
    text-align: center;
    background: linear-gradient(180deg, var(--profundo) 0%, #060D1A 100%);
    position: relative;
    border-top: 1px solid var(--linea-suave);
    overflow: hidden;
  }

  .cierre__luna {
    width: 4.25rem;
    height: 4.25rem;
    margin: 0 auto 1.75rem;
    border-radius: 50%;
    background: var(--crema);
    box-shadow: 0 0 50px rgba(245, 239, 230, 0.6), 0 0 100px rgba(212, 175, 55, 0.35);
  }

  .cierre__gracias {
    font-family: var(--titulo);
    font-style: italic;
    font-size: 1.35rem;
    color: var(--plata);
    margin-bottom: 0.5rem;
  }

  .cierre__nombres {
    font-family: var(--script);
    font-size: clamp(3.8rem, 12vw, 6rem);
    color: var(--dorado);
    line-height: 1.05;
    margin: 0.25rem 0 0.5rem;
    text-shadow: 0 0 25px rgba(212, 175, 55, 0.3);
  }

  .cierre__fecha-lugar {
    font-size: 1.05rem;
    color: var(--crema);
    margin-bottom: 1.25rem;
    letter-spacing: 0.04em;
  }

  .cierre__hashtag {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--titulo);
    font-size: 1.45rem;
    font-weight: 600;
    color: var(--dorado) !important;
    letter-spacing: 0.05em;
    margin-bottom: 1.75rem !important;
  }

  .hashtag-star {
    color: var(--dorado);
    opacity: 0.8;
    animation: titilar-icon 3s ease-in-out infinite alternate;
  }

  @keyframes titilar-icon {
    0% { transform: scale(0.9); opacity: 0.6; }
    100% { transform: scale(1.2) rotate(15deg); opacity: 1; filter: drop-shadow(0 0 4px #D4AF37); }
  }

  .cierre__separador {
    display: flex;
    justify-content: center;
    gap: 0.85rem;
    color: var(--dorado);
    opacity: 0.5;
    font-size: 0.85rem;
    margin-bottom: 2rem;
  }

  /* Créditos y autor Hugo Adama vinculado a GitHub */
  .cierre__creditos {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    margin: 0 auto;
    max-width: 34rem;
  }

  .creditos__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.45rem 1.15rem;
    background: rgba(11, 29, 58, 0.65);
    border: 1px solid var(--linea);
    border-radius: var(--radio-full);
    color: var(--crema);
    font-size: 0.85rem;
    text-decoration: none;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
    transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease, color 0.25s ease;
  }

  .creditos__badge:hover {
    transform: translateY(-2px);
    border-color: var(--dorado);
    color: #ffffff;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.45), 0 0 15px rgba(212, 175, 55, 0.3);
  }

  .github-icon {
    color: var(--dorado);
    flex-shrink: 0;
  }

  .autor-nombre {
    color: var(--dorado);
    font-weight: 600;
    transition: color 0.2s ease;
  }

  .creditos__badge:hover .autor-nombre {
    color: #FFF4D0;
    text-shadow: 0 0 8px rgba(212, 175, 55, 0.6);
  }

  .creditos__leyenda {
    font-size: 0.78rem;
    color: var(--plata);
    opacity: 0.7;
    margin: 0;
    letter-spacing: 0.05em;
  }
</style>
