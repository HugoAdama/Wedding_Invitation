---
import { weddingData } from '../../data/wedding';
import StarIcon from '../icons/StarIcon.astro';
---
<footer class="cierre">
  <div class="cierre__luna pulso-lunar" aria-hidden="true"></div>
  <p class="cierre__gracias">Gracias por ser parte fundamental de nuestra historia</p>
  <h2 class="cierre__nombres brillo-dorado">{weddingData.brideName} &amp; {weddingData.groomName}</h2>
  <p class="cierre__fecha-lugar">{weddingData.dateFormatted} · {weddingData.city}</p>
  <p class="cierre__hashtag">
    <StarIcon size={14} class="hashtag-star" />
    <span>{weddingData.hashtag}</span>
    <StarIcon size={14} class="hashtag-star" />
  </p>
  <p class="cierre__creditos">
    Boda de cielo estrellado · Arequipa, Perú · Arquitectura modular en Astro 7 &amp; Node 20
  </p>
</footer>

<style>
  .cierre {
    padding: 5.5rem var(--lado) calc(4rem + env(safe-area-inset-bottom, 0px));
    text-align: center;
    background: linear-gradient(180deg, var(--profundo) 0%, #060D1A 100%);
    position: relative;
    border-top: 1px solid var(--linea-suave);
    overflow: hidden;
  }

  .cierre__luna {
    width: 4.25rem;
    height: 4.25rem;
    margin: 0 auto 1.75rem;
    border-radius: 50%;
    background: var(--crema);
    box-shadow: 0 0 50px rgba(245, 239, 230, 0.6), 0 0 100px rgba(212, 175, 55, 0.35);
  }

  .cierre__gracias {
    font-family: var(--titulo);
    font-style: italic;
    font-size: 1.35rem;
    color: var(--plata);
    margin-bottom: 0.5rem;
  }

  .cierre__nombres {
    font-family: var(--script);
    font-size: clamp(3.8rem, 12vw, 6rem);
    color: var(--dorado);
    line-height: 1.05;
    margin: 0.25rem 0 0.5rem;
    text-shadow: 0 0 25px rgba(212, 175, 55, 0.3);
  }

  .cierre__fecha-lugar {
    font-size: 1.05rem;
    color: var(--crema);
    margin-bottom: 1.25rem;
    letter-spacing: 0.04em;
  }

  .cierre__hashtag {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--titulo);
    font-size: 1.45rem;
    font-weight: 600;
    color: var(--dorado) !important;
    letter-spacing: 0.05em;
    margin-bottom: 2rem !important;
  }

  .hashtag-star {
    color: var(--dorado);
    opacity: 0.8;
    animation: titilar-icon 3s ease-in-out infinite alternate;
  }

  @keyframes titilar-icon {
    0% { transform: scale(0.9); opacity: 0.6; }
    100% { transform: scale(1.2) rotate(15deg); opacity: 1; filter: drop-shadow(0 0 4px #D4AF37); }
  }

  .cierre__creditos {
    font-size: 0.82rem;
    color: var(--plata);
    opacity: 0.65;
    max-width: 32rem;
    margin: 0 auto;
    line-height: 1.5;
  }
</style>
