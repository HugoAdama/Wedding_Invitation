---
import { giftOptions, giftQuote } from '../../data/gifts';
import GiftIcon from '../icons/GiftIcon.astro';
import MailIcon from '../icons/MailIcon.astro';
import BookOpenIcon from '../icons/BookOpenIcon.astro';
import SparklesIcon from '../icons/SparklesIcon.astro';
import MoonPhasesOrnament from '../icons/MoonPhasesOrnament.astro';
---
<section class="seccion seccion--violeta" id="regalos">
  <div class="interior">
    <div class="seccion-header">
      <div class="regalos__adorno">
        <MoonPhasesOrnament class="w-40 h-auto mx-auto mb-4 text-[#F5EFE6]" />
      </div>
      <div class="regalos__badge">
        <GiftIcon size={18} class="text-[#D4AF37]" />
        <span>Detalles &amp; Presentes</span>
      </div>
      <p class="kicker" style="color: var(--crema);">Un detalle, si lo deseas</p>
      <h2 class="titulo-seccion" style="color: #F8E7B4;">Mesa de regalos</h2>
      <p class="regalos__cita">{giftQuote}</p>
    </div>

    <!-- Grid de 4 Opciones de Regalos Equilibradas -->
    <div class="regalos-grid">
      {giftOptions.map((opcion, idx) => (
        <article class={`regalo-card revelar ${idx % 2 === 1 ? 'revelar--retraso-1' : ''}`}>
          <div class="regalo__top">
            <div class="regalo__icono-box">
              {idx === 0 && <MailIcon size={20} class="text-[#D4AF37]" />}
              {idx === 1 && <SparklesIcon size={20} class="text-[#D4AF37]" />}
              {idx === 2 && <GiftIcon size={20} class="text-[#D4AF37]" />}
              {idx === 3 && <BookOpenIcon size={20} class="text-[#D4AF37]" />}
            </div>
            {opcion.badge && <span class="badge-tag">{opcion.badge}</span>}
          </div>

          <h3 class="regalo__titulo">{opcion.title}</h3>
          <p class="regalo__desc">{opcion.description}</p>

          {opcion.details && (
            <div class="regalo__detalles">
              {opcion.details.map(det => (
                <div class="detalle-fila">
                  {det.label && <span class="detalle-label">{det.label}:</span>}
                  {det.isCode ? (
                    <div class="codigo-copiable-wrap">
                      <code class="detalle-code">{det.value}</code>
                      <button
                        type="button"
                        class="btn-copiar"
                        data-copiar={det.value}
                        aria-label={`Copiar ${det.label || 'cuenta'}`}
                        title="Copiar al portapapeles"
                      >
                        <span class="btn-copiar-txt">Copiar</span>
                      </button>
                    </div>
                  ) : (
                    <span class="detalle-val">{det.value}</span>
                  )}
                </div>
              ))}
            </div>
          )}

          {idx === 0 && (
            <div class="regalo__pie-nota">
              <span>✉️ Encontrarás el buzón nupcial junto al libro de firmas en la recepción.</span>
            </div>
          )}

          {idx === 3 && (
            <div class="regalo__pie-nota">
              <span>📖 Un rincón especial de nuestra casa llevará las lecturas de quienes más amamos.</span>
            </div>
          )}
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .regalos__adorno {
    text-align: center;
  }

  .regalos__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 1rem;
    font-size: 0.82rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--crema);
    background: rgba(245, 239, 230, 0.15);
    border: 1px solid rgba(245, 239, 230, 0.3);
    border-radius: var(--radio-full);
    margin-bottom: 0.9rem;
  }

  .regalos__cita {
    font-family: var(--titulo);
    font-style: italic;
    font-size: clamp(1.2rem, 3vw, 1.45rem);
    line-height: 1.6;
    color: var(--crema);
    max-width: 44rem;
    margin: 1.25rem auto 0;
    opacity: 0.95;
  }

  .regalos-grid {
    display: grid;
    gap: 2rem;
    margin-top: 3.5rem;
  }

  @media (min-width: 768px) {
    .regalos-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 2.25rem;
    }
  }

  .regalo-card {
    background: rgba(11, 29, 58, 0.7);
    border: 1px solid var(--linea);
    border-radius: var(--radio-md);
    padding: 2rem 2.25rem;
    box-shadow: 0 12px 35px rgba(0, 0, 0, 0.4);
    display: flex;
    flex-direction: column;
    transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .regalo-card:hover {
    transform: translateY(-4px);
    border-color: var(--dorado);
    box-shadow: 0 16px 45px rgba(0, 0, 0, 0.5), 0 0 25px rgba(212, 175, 55, 0.2);
  }

  .regalo__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  .regalo__icono-box {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    background: rgba(7, 16, 32, 0.8);
    border: 1px solid var(--linea-suave);
    flex-shrink: 0;
  }

  .badge-tag {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--dorado);
    background: rgba(212, 175, 55, 0.12);
    border: 1px solid var(--linea-suave);
    padding: 0.25rem 0.75rem;
    border-radius: var(--radio-full);
  }

  .regalo__titulo {
    font-family: var(--titulo);
    font-size: 1.6rem;
    color: var(--dorado);
    margin: 0 0 0.6rem;
    line-height: 1.2;
  }

  .regalo__desc {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--crema);
    opacity: 0.92;
    margin: 0 0 1.25rem;
  }

  .regalo__detalles {
    display: grid;
    gap: 0.75rem;
    margin-top: auto;
    padding-top: 1.25rem;
    border-top: 1px solid var(--linea-suave);
    font-size: 0.9rem;
  }

  .detalle-fila {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
  }

  .detalle-label {
    color: var(--plata);
    font-size: 0.85rem;
  }

  .detalle-val {
    color: var(--crema);
    font-weight: 500;
  }

  .codigo-copiable-wrap {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    flex-wrap: wrap;
  }

  .detalle-code {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.88rem;
    color: var(--dorado);
    background: rgba(7, 16, 32, 0.85);
    padding: 0.3rem 0.65rem;
    border-radius: var(--radio-sm);
    border: 1px solid rgba(212, 175, 55, 0.35);
    user-select: all;
  }

  .btn-copiar {
    padding: 0.3rem 0.7rem;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--dorado);
    background: rgba(212, 175, 55, 0.15);
    border: 1px solid var(--dorado);
    border-radius: var(--radio-sm);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .btn-copiar:hover {
    background: var(--dorado);
    color: var(--noche);
    transform: translateY(-1px);
  }

  .btn-copiar--copiado {
    background: #2e7d32 !important;
    border-color: #4caf50 !important;
    color: #ffffff !important;
  }

  .regalo__pie-nota {
    margin-top: auto;
    padding-top: 1.25rem;
    border-top: 1px solid var(--linea-suave);
    font-size: 0.85rem;
    color: var(--plata);
    font-style: italic;
    line-height: 1.45;
  }
</style>

<script>
  function setupCopiarBotones() {
    document.querySelectorAll('.btn-copiar').forEach(boton => {
      boton.addEventListener('click', async () => {
        const texto = boton.getAttribute('data-copiar');
        if (!texto) return;

        try {
          await navigator.clipboard.writeText(texto);
          const txtSpan = boton.querySelector('.btn-copiar-txt');
          if (txtSpan) txtSpan.textContent = '¡Copiado! ✓';
          boton.classList.add('btn-copiar--copiado');

          setTimeout(() => {
            if (txtSpan) txtSpan.textContent = 'Copiar';
            boton.classList.remove('btn-copiar--copiado');
          }, 2200);
        } catch {
          // Fallback silencioso
        }
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupCopiarBotones);
  } else {
    setupCopiarBotones();
  }
</script>
