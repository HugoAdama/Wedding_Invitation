---
import StarIcon from '../icons/StarIcon.astro';
import MenuIcon from '../icons/MenuIcon.astro';
import CloseIcon from '../icons/CloseIcon.astro';
import MobileNavDrawer from '../ui/MobileNavDrawer.astro';
import { mainNavLinks } from '../../data/navigation';
---
<header class="cab" id="cabecera-principal">
  <div class="cab__fila">
    <a class="cab__logo" href="#inicio" aria-label="Inicio: Daniela y Rodrigo">
      <span class="logo__letra">D</span>
      <span class="logo__amp">&amp;</span>
      <span class="logo__letra">R</span>
    </a>

    <!-- Menú para escritorio (links con nombres concisos y sin quiebres de línea) -->
    <nav class="cab__menu" aria-label="Secciones principales">
      {mainNavLinks.map(link => (
        <a href={link.href} class="cab__enlace">{link.label}</a>
      ))}
    </nav>

    <div class="cab__acciones">
      <a class="boton boton--chico boton--lleno cab__btn-confirmar" href="#confirmar">
        <StarIcon size={14} class="star-icon" />
        <span>Confirmar</span>
      </a>

      <!-- Botón de menú hamburguesa móvil/tablet -->
      <button
        class="cab__toggle"
        id="menu-toggle"
        aria-label="Abrir menú de navegación"
        aria-expanded="false"
        aria-controls="menu-movil"
      >
        <span class="icono-abrir"><MenuIcon size={24} /></span>
        <span class="icono-cerrar" hidden><CloseIcon size={24} /></span>
      </button>
    </div>
  </div>

  <MobileNavDrawer />
</header>

<style>
  .cab {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(11, 29, 58, 0.94);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--linea-suave);
    transition: var(--transicion);
  }

  .cab__fila {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 80rem;
    height: 4.25rem;
    margin-inline: auto;
    padding-inline: var(--lado);
    gap: 1rem;
  }

  .cab__logo {
    display: inline-flex;
    align-items: baseline;
    gap: 0.25rem;
    font-family: var(--script);
    font-size: 2.2rem;
    color: var(--dorado);
    text-shadow: 0 0 15px rgba(212, 175, 55, 0.35);
    flex-shrink: 0;
    margin-right: 0.5rem;
    line-height: 1;
  }

  .logo__letra {
    display: inline-block;
  }

  .logo__amp {
    font-size: 1.45rem;
    opacity: 0.85;
    color: var(--dorado);
  }

  /* Menú de escritorio */
  .cab__menu {
    display: none;
  }

  @media (min-width: 1100px) {
    .cab__menu {
      display: flex;
      align-items: center;
      gap: clamp(0.75rem, 1.3vw, 1.4rem);
      flex: 1;
      justify-content: center;
    }

    .cab__enlace {
      font-size: clamp(0.82rem, 0.9vw, 0.9rem);
      color: var(--crema);
      letter-spacing: 0.02em;
      position: relative;
      padding-block: 0.35rem;
      white-space: nowrap;
      flex-shrink: 0;
      transition: color 0.2s ease;
    }

    .cab__enlace:hover {
      color: var(--dorado);
    }

    .cab__enlace::after {
      content: "";
      position: absolute;
      left: 0;
      bottom: 0;
      width: 0;
      height: 1.5px;
      background: var(--dorado);
      box-shadow: 0 0 6px rgba(212, 175, 55, 0.6);
      transition: width 0.25s ease;
    }

    .cab__enlace:hover::after,
    .cab__enlace--activo::after {
      width: 100%;
    }

    .cab__enlace--activo {
      color: var(--dorado);
      font-weight: 500;
    }
  }

  .cab__acciones {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-shrink: 0;
  }

  .cab__btn-confirmar {
    display: none;
  }

  @media (min-width: 540px) {
    .cab__btn-confirmar {
      display: inline-flex;
      white-space: nowrap;
    }
  }

  /* Botón hamburguesa móvil */
  .cab__toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    background: rgba(27, 42, 74, 0.6);
    border: 1px solid var(--linea);
    border-radius: var(--radio-sm);
    color: var(--dorado);
    cursor: pointer;
    transition: var(--transicion);
  }

  .cab__toggle:hover {
    background: rgba(212, 175, 55, 0.15);
    border-color: var(--dorado);
  }

  @media (min-width: 1100px) {
    .cab__toggle {
      display: none;
    }
  }
</style>

<script>
  function setupScrollSpy() {
    const navLinksDesktop = document.querySelectorAll('.cab__menu .cab__enlace');
    const navLinksMobile = document.querySelectorAll('.menu-movil__nav .menu-movil__enlace');
    const sections = Array.from(document.querySelectorAll('section[id]'));
    if (!sections.length) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const id = entry.target.getAttribute('id');
            if (!id) return;

            navLinksDesktop.forEach((link) => {
              const href = link.getAttribute('href');
              if (href === `#${id}`) {
                link.classList.add('cab__enlace--activo');
              } else {
                link.classList.remove('cab__enlace--activo');
              }
            });

            navLinksMobile.forEach((link) => {
              const href = link.getAttribute('href');
              if (href === `#${id}`) {
                link.classList.add('menu-movil__enlace--activo');
              } else {
                link.classList.remove('menu-movil__enlace--activo');
              }
            });
          }
        });
      },
      {
        threshold: 0.25,
        rootMargin: '-80px 0px -40% 0px'
      }
    );

    sections.forEach((sec) => observer.observe(sec));
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupScrollSpy);
  } else {
    setupScrollSpy();
  }
</script>
