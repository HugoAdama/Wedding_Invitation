---
import { celestialExperiences, themeDetails } from '../../data/experience';
import GalaxyIcon from '../icons/GalaxyIcon.astro';
import TelescopeIcon from '../icons/TelescopeIcon.astro';
import MusicIcon from '../icons/MusicIcon.astro';
import BookOpenIcon from '../icons/BookOpenIcon.astro';
import StarIcon from '../icons/StarIcon.astro';
import { withBase } from '../../utils/paths';
---
<section class="seccion" id="la-noche">
  <div class="interior">
    <div class="seccion-header">
      <div class="noche__badge">
        <GalaxyIcon size={18} class="text-[#D4AF37]" />
        <span>Atmósfera &amp; Concepto</span>
      </div>
      <p class="kicker">El tema de la celebración</p>
      <h2 class="titulo-seccion">Una noche para mirar arriba</h2>
      <p class="descripcion-seccion">
        {themeDetails.summary}
      </p>
    </div>

    <div class="noche-grid">
      <!-- Foto de ambientación nocturna -->
      <div class="noche__foto-col revelar">
        <div class="noche__marco">
          <img
            src={withBase(themeDetails.image)}
            alt="Telescopio apuntando al firmamento estrellado"
            width="640"
            height="800"
            loading="lazy"
            decoding="async"
          />
          <div class="noche__marco-overlay">
            <span class="noche__overlay-tag">Experiencia Guiada</span>
            <p class="noche__overlay-txt">Cielo despejado de Arequipa y observación astronómica</p>
          </div>
        </div>
      </div>

      <!-- Cuadrícula de 4 experiencias interactivas -->
      <div class="noche__items-col">
        <div class="experiencias-grid">
          {celestialExperiences.map((item, idx) => (
            <article class={`experiencia-card revelar ${idx > 0 ? `revelar--retraso-${Math.min(idx, 3)}` : ''}`}>
              <div class="experiencia__icono-wrapper">
                {item.icon === 'telescope' && <TelescopeIcon size={22} />}
                {item.icon === 'music' && <MusicIcon size={22} />}
                {item.icon === 'book' && <BookOpenIcon size={22} />}
                {item.icon === 'map-star' && <StarIcon size={22} />}
              </div>
              <div class="experiencia__texto">
                <h3 class="experiencia__titulo">{item.title}</h3>
                <p class="experiencia__desc">{item.description}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .noche__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 1rem;
    font-size: 0.82rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--dorado);
    background: rgba(212, 175, 55, 0.1);
    border: 1px solid var(--linea);
    border-radius: var(--radio-full);
    margin-bottom: 0.9rem;
  }

  .noche-grid {
    display: grid;
    gap: 3rem;
    align-items: center;
  }

  @media (min-width: 960px) {
    .noche-grid {
      grid-template-columns: 0.85fr 1.15fr;
      gap: 3.5rem;
    }
  }

  .noche__foto-col {
    max-width: 25rem;
    margin: 0 auto;
    width: 100%;
  }

  .noche__marco {
    position: relative;
    border-radius: var(--radio-md);
    overflow: hidden;
    border: 1.5px solid var(--linea);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.55), 0 0 25px rgba(212, 175, 55, 0.15);
    background: var(--noche);
  }

  .noche__marco img {
    width: 100%;
    aspect-ratio: 4 / 5.2;
    object-fit: cover;
    display: block;
    transition: transform 0.6s ease;
  }

  .noche__marco:hover img {
    transform: scale(1.04);
  }

  .noche__marco-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 1.25rem 1rem 0.85rem;
    background: linear-gradient(0deg, rgba(7, 16, 32, 0.95) 0%, rgba(7, 16, 32, 0.6) 70%, transparent 100%);
    text-align: center;
  }

  .noche__overlay-tag {
    display: block;
    font-size: 0.78rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--dorado);
    margin-bottom: 0.2rem;
  }

  .noche__overlay-txt {
    font-size: 0.85rem;
    color: var(--crema);
    opacity: 0.9;
    margin: 0;
  }

  /* Grid 2x2 de Experiencias */
  .experiencias-grid {
    display: grid;
    gap: 1.25rem;
  }

  @media (min-width: 600px) {
    .experiencias-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .experiencia-card {
    background: rgba(27, 42, 74, 0.45);
    border: 1px solid var(--linea-suave);
    border-radius: var(--radio-md);
    padding: 1.6rem 1.45rem;
    box-shadow: var(--sombra-suave);
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
    transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .experiencia-card:hover {
    transform: translateY(-6px);
    border-color: var(--dorado);
    box-shadow: var(--sombra-hover);
  }

  .experiencia__icono-wrapper {
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    background: rgba(7, 16, 32, 0.8);
    border: 1px solid var(--linea);
    color: var(--dorado);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 0 18px rgba(212, 175, 55, 0.2);
    flex-shrink: 0;
  }

  .experiencia__texto {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .experiencia__titulo {
    font-family: var(--titulo);
    font-size: 1.45rem;
    color: #FFF2A8;
    margin: 0;
    line-height: 1.25;
  }

  .experiencia__desc {
    font-size: 0.95rem;
    line-height: 1.65;
    color: var(--crema);
    opacity: 0.92;
    margin: 0;
  }
</style>
