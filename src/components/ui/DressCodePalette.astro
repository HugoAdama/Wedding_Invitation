---
import { paletteColors } from '../../data/dressCode';
import PaletteIcon from '../icons/PaletteIcon.astro';
---

<div class="vestir__paleta-bloque revelar">
  <div class="paleta-bloque__header">
    <div class="paleta-bloque__icono">
      <PaletteIcon size={22} class="text-[#D4AF37]" />
    </div>
    <div>
      <h3 class="paleta-bloque__titulo">Inspiración Cromática</h3>
      <p class="paleta-bloque__desc">
        Tonos inspirados en el firmamento y las constelaciones de Arequipa para guiar la elección de vestidos, trajes y accesorios.
      </p>
    </div>
  </div>

  <div class="paleta-swatches-grid">
    {paletteColors.map(color => (
      <div class="paleta-swatch-item">
        <div class="swatch-circulo-wrapper">
          <span
            class="swatch-circulo"
            style={`background-color: ${color.hex};`}
            aria-label={`Muestra de color ${color.name}`}
          ></span>
        </div>
        <div class="swatch-info">
          <span class="swatch-nombre">{color.name}</span>
          <span class="swatch-desc">{color.description}</span>
          <span class="swatch-hex">{color.hex}</span>
        </div>
      </div>
    ))}
  </div>
</div>

<style>
  .vestir__paleta-bloque {
    background: radial-gradient(circle at top, rgba(74, 59, 107, 0.25) 0%, rgba(27, 42, 74, 0.55) 100%);
    border: 1px solid var(--linea);
    border-radius: var(--radio-lg);
    padding: clamp(1.75rem, 3.5vw, 2.5rem);
    box-shadow: var(--sombra-suave);
    margin-bottom: 3rem;
  }

  .paleta-bloque__header {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 2rem;
    max-width: 44rem;
  }

  .paleta-bloque__icono {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--radio-full);
    background: rgba(212, 175, 55, 0.12);
    border: 1px solid var(--linea);
    flex-shrink: 0;
  }

  .paleta-bloque__titulo {
    font-family: var(--titulo);
    font-size: clamp(1.5rem, 3vw, 1.85rem);
    color: var(--dorado);
    margin-bottom: 0.25rem;
  }

  .paleta-bloque__desc {
    font-size: 0.95rem;
    color: var(--crema);
    opacity: 0.88;
    line-height: 1.55;
    margin: 0;
  }

  .paleta-swatches-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
  }

  @media (min-width: 540px) {
    .paleta-swatches-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 860px) {
    .paleta-swatches-grid {
      grid-template-columns: repeat(5, 1fr);
      gap: 1.25rem;
    }
  }

  .paleta-swatch-item {
    background: rgba(11, 29, 58, 0.6);
    border: 1px solid var(--linea-suave);
    border-radius: var(--radio-md);
    padding: 1.25rem 0.85rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.75rem;
    transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
  }

  .paleta-swatch-item:hover {
    transform: translateY(-4px);
    border-color: var(--dorado);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4), 0 0 15px rgba(212, 175, 55, 0.2);
  }

  .swatch-circulo-wrapper {
    position: relative;
    padding: 4px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.05);
    border: 1px dashed rgba(212, 175, 55, 0.4);
    transition: border-color 0.25s ease;
  }

  .paleta-swatch-item:hover .swatch-circulo-wrapper {
    border-color: var(--dorado);
  }

  .swatch-circulo {
    display: block;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 50%;
    border: 2px solid rgba(255, 255, 255, 0.8);
    box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.3), 0 4px 12px rgba(0, 0, 0, 0.4);
  }

  .swatch-info {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    align-items: center;
  }

  .swatch-nombre {
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--crema);
  }

  .swatch-desc {
    font-size: 0.76rem;
    color: var(--plata);
    opacity: 0.85;
  }

  .swatch-hex {
    font-size: 0.72rem;
    font-family: monospace;
    letter-spacing: 0.06em;
    color: var(--dorado);
    background: rgba(7, 16, 32, 0.7);
    padding: 0.15rem 0.5rem;
    border-radius: var(--radio-full);
    border: 1px solid var(--linea-suave);
    margin-top: 0.25rem;
  }
</style>
