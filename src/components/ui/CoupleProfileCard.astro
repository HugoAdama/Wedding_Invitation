---
import BrideIcon from '../icons/BrideIcon.astro';
import GroomIcon from '../icons/GroomIcon.astro';
import StarIcon from '../icons/StarIcon.astro';
import QuoteIcon from '../icons/QuoteIcon.astro';
import { withBase } from '../../utils/paths';
import type { CoupleProfile } from '../../types/wedding';

interface Props {
  profile: CoupleProfile;
  delayClass?: string;
}

const { profile, delayClass = '' } = Astro.props;
const isBride = profile.role === 'La Novia';
---

<article class={`novio-card revelar ${delayClass}`}>
  <div class="novio__foto-wrapper">
    <img
      src={withBase(profile.photoUrl)}
      alt={`Retrato de ${profile.fullName}`}
      width="640"
      height="800"
      loading="lazy"
      decoding="async"
    />
    <div class={`novio__badge ${isBride ? 'novio__badge--daniela' : 'novio__badge--rodrigo'}`}>
      {isBride ? <BrideIcon size={20} /> : <GroomIcon size={20} />}
      <span>{profile.role}</span>
    </div>
  </div>

  <h3 class="novio__nombre">{profile.name}</h3>
  <p class="novio__ocupacion">{profile.occupation} · {profile.education}</p>

  <div class="novio__cita">
    <QuoteIcon size={18} class="novio__quote-icon" />
    <p>«{profile.favoriteQuote}»</p>
  </div>

  <p class="novio__bio">{profile.personality}</p>

  <!-- Conexión estelar -->
  <div class="novio__estelar">
    <h4 class="estelar__titulo">
      <StarIcon size={16} />
      <span>Conexión con el cielo estrellado</span>
    </h4>
    <ul class="estelar__lista">
      {profile.starlitConnection.map(item => (
        <li>
          <strong>{item.title}:</strong> {item.description}
        </li>
      ))}
    </ul>
  </div>
</article>

<style>
  .novio-card {
    text-align: center;
    background: rgba(27, 42, 74, 0.45);
    border: 1px solid var(--linea-suave);
    border-radius: var(--radio-lg);
    padding: clamp(2rem, 4vw, 3rem) clamp(1.5rem, 3vw, 2.5rem);
    box-shadow: var(--sombra-suave);
    transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .novio-card:hover {
    border-color: var(--dorado);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6), 0 0 25px rgba(212, 175, 55, 0.25);
    transform: translateY(-6px);
  }

  .novio__foto-wrapper {
    position: relative;
    max-width: 19rem;
    margin: 0 auto 2rem;
  }

  .novio__foto-wrapper img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 200px 200px 14px 14px;
    border: 1.5px solid var(--dorado);
    box-shadow: 0 0 40px rgba(0, 0, 0, 0.5);
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .novio-card:hover .novio__foto-wrapper img {
    transform: scale(1.03);
  }

  .novio__badge {
    position: absolute;
    bottom: -0.75rem;
    left: 50%;
    transform: translateX(-50%);
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.38rem 1.15rem;
    font-size: 0.82rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--noche);
    background: var(--dorado);
    border-radius: var(--radio-full);
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.35);
  }

  .novio__nombre {
    margin-bottom: 0.3rem;
    font-family: var(--script);
    font-size: clamp(3.2rem, 7vw, 4.2rem);
    color: var(--dorado);
    text-shadow: 0 0 20px rgba(212, 175, 55, 0.3);
  }

  .novio__ocupacion {
    font-family: var(--titulo);
    font-style: italic;
    font-size: 1.25rem;
    color: #FFF2A8;
    margin-bottom: 1.25rem;
  }

  .novio__cita {
    position: relative;
    max-width: 25rem;
    margin: 0 auto 1.25rem;
    padding: 0.85rem 1.35rem;
    background: rgba(11, 29, 58, 0.55);
    border-left: 2px solid var(--dorado);
    border-radius: 0 var(--radio-sm) var(--radio-sm) 0;
    font-family: var(--titulo);
    font-style: italic;
    font-size: 1.2rem;
    color: var(--crema);
    line-height: 1.6;
  }

  .novio__quote-icon {
    display: inline-block;
    color: var(--dorado);
    opacity: 0.7;
    margin-bottom: 0.2rem;
  }

  .novio__bio {
    max-width: 26rem;
    margin: 0 auto 1.5rem;
    font-size: 0.98rem;
    line-height: 1.7;
    color: var(--crema);
    opacity: 0.94;
  }

  .novio__estelar {
    background: rgba(11, 29, 58, 0.6);
    border: 1px solid var(--linea-suave);
    border-radius: var(--radio-md);
    padding: 1.35rem;
    margin-bottom: 0;
    text-align: left;
  }

  .estelar__titulo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--titulo);
    font-size: 1.25rem;
    color: var(--dorado);
    margin-bottom: 0.75rem;
  }

  .estelar__lista {
    font-size: 0.94rem;
    line-height: 1.65;
    color: var(--crema);
    opacity: 0.94;
    display: grid;
    gap: 0.55rem;
  }
</style>
