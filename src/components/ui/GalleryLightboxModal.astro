---
import { weddingGallery } from '../../data/gallery';
---

<!-- Modal / Visor Lightbox celestial -->
<dialog id="galeria-lightbox" class="lightbox-dialog" aria-modal="true" aria-label="Visor de fotos en pantalla completa">
  <div class="lightbox-contenido">
    <div class="lightbox-header">
      <span class="lightbox-contador" id="lightbox-contador">1 / 6</span>
      <button type="button" class="lightbox-btn-cerrar" id="lightbox-btn-cerrar" aria-label="Cerrar visor">
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <div class="lightbox-cuerpo">
      <button type="button" class="lightbox-nav lightbox-nav--prev" id="lightbox-prev" aria-label="Foto anterior">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>

      <div class="lightbox-imagen-wrap">
        <img id="lightbox-img" src="" alt="" />
      </div>

      <button type="button" class="lightbox-nav lightbox-nav--next" id="lightbox-next" aria-label="Siguiente foto">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>
    </div>

    <div class="lightbox-footer">
      <h3 class="lightbox-titulo" id="lightbox-titulo"></h3>
      <p class="lightbox-sub" id="lightbox-sub"></p>
    </div>
  </div>
</dialog>

<style>
  .lightbox-dialog {
    padding: 0;
    border: none;
    border-radius: var(--radio-lg);
    background: transparent;
    max-width: 95vw;
    max-height: 95vh;
    overflow: hidden;
  }

  .lightbox-dialog::backdrop {
    background: rgba(5, 7, 18, 0.88);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  .lightbox-contenido {
    display: flex;
    flex-direction: column;
    background: rgba(11, 16, 33, 0.95);
    border: 1px solid rgba(212, 175, 55, 0.4);
    border-radius: var(--radio-lg);
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.7), 0 0 30px rgba(212, 175, 55, 0.2);
    overflow: hidden;
    max-height: 92vh;
  }

  .lightbox-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1.25rem;
    border-bottom: 1px solid rgba(212, 175, 55, 0.2);
  }

  .lightbox-contador {
    font-size: 0.85rem;
    font-weight: 600;
    color: #D4AF37;
    letter-spacing: 0.05em;
  }

  .lightbox-btn-cerrar {
    background: transparent;
    border: none;
    color: var(--plata-estelar);
    cursor: pointer;
    padding: 0.3rem;
    border-radius: 50%;
    display: grid;
    place-items: center;
    transition: all 0.2s ease;
  }

  .lightbox-btn-cerrar:hover {
    color: #FFF2A8;
    background: rgba(212, 175, 55, 0.15);
  }

  .lightbox-cuerpo {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 250px;
    max-height: 68vh;
    overflow: hidden;
    background: #050811;
  }

  .lightbox-imagen-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    max-height: 68vh;
    padding: 0.5rem;
  }

  .lightbox-imagen-wrap img {
    max-width: 100%;
    max-height: 64vh;
    object-fit: contain;
    border-radius: var(--radio-sm);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.5);
  }

  .lightbox-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(11, 16, 33, 0.7);
    border: 1px solid rgba(212, 175, 55, 0.4);
    color: #FFF2A8;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    cursor: pointer;
    transition: all 0.2s ease;
    z-index: 10;
  }

  .lightbox-nav:hover {
    background: #D4AF37;
    color: #070B19;
    box-shadow: 0 0 15px rgba(212, 175, 55, 0.6);
  }

  .lightbox-nav--prev { left: 1rem; }
  .lightbox-nav--next { right: 1rem; }

  .lightbox-footer {
    padding: 0.85rem 1.25rem 1.1rem;
    background: rgba(11, 16, 33, 0.9);
    border-top: 1px solid rgba(212, 175, 55, 0.15);
    text-align: center;
  }

  .lightbox-titulo {
    font-family: var(--titulo);
    font-size: 1.25rem;
    color: #FFF2A8;
    margin: 0 0 0.25rem;
  }

  .lightbox-sub {
    font-size: 0.85rem;
    color: var(--plata);
    margin: 0;
    max-width: 42rem;
    margin-inline: auto;
  }

  @media (max-width: 600px) {
    .lightbox-nav {
      width: 36px;
      height: 36px;
    }
    .lightbox-nav--prev { left: 0.4rem; }
    .lightbox-nav--next { right: 0.4rem; }
  }
</style>

<script define:vars={{ fotos: weddingGallery, base: import.meta.env.BASE_URL }}>
  function initLightbox() {
    const dialog = document.getElementById('galeria-lightbox');
    const imgEl = document.getElementById('lightbox-img');
    const tituloEl = document.getElementById('lightbox-titulo');
    const subEl = document.getElementById('lightbox-sub');
    const contadorEl = document.getElementById('lightbox-contador');
    const btnCerrar = document.getElementById('lightbox-btn-cerrar');
    const btnPrev = document.getElementById('lightbox-prev');
    const btnNext = document.getElementById('lightbox-next');

    if (!dialog || !imgEl || !tituloEl || !subEl || !contadorEl) return;

    let currentIndex = 0;
    const cleanBase = (base || '/').replace(/\/$/, '');

    function getFullUrl(path) {
      if (!path) return '';
      if (path.startsWith('http://') || path.startsWith('https://')) return path;
      const cleanPath = path.startsWith('/') ? path : `/${path}`;
      return `${cleanBase}${cleanPath}`;
    }

    function mostrarFoto(idx) {
      if (idx < 0) idx = fotos.length - 1;
      if (idx >= fotos.length) idx = 0;
      currentIndex = idx;

      const foto = fotos[currentIndex];
      imgEl.src = getFullUrl(foto.image);
      imgEl.alt = foto.title;
      tituloEl.textContent = foto.title;
      subEl.textContent = foto.caption;
      contadorEl.textContent = `${currentIndex + 1} / ${fotos.length}`;
    }

    // Abrir al hacer clic en cualquier tarjeta
    document.querySelectorAll('[data-lightbox-trigger]').forEach(card => {
      const abrir = () => {
        const idx = parseInt(card.getAttribute('data-index') || '0', 10);
        mostrarFoto(idx);
        dialog.showModal();
        document.body.style.overflow = 'hidden';
      };

      card.addEventListener('click', abrir);
      card.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          abrir();
        }
      });
    });

    function cerrar() {
      dialog.close();
      document.body.style.overflow = '';
    }

    btnCerrar?.addEventListener('click', cerrar);

    // Cerrar al hacer clic en el backdrop
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) {
        cerrar();
      }
    });

    btnPrev?.addEventListener('click', () => mostrarFoto(currentIndex - 1));
    btnNext?.addEventListener('click', () => mostrarFoto(currentIndex + 1));

    // Navegación con flechas del teclado y Escape
    window.addEventListener('keydown', (e) => {
      if (!dialog.open) return;
      if (e.key === 'ArrowLeft') {
        mostrarFoto(currentIndex - 1);
      } else if (e.key === 'ArrowRight') {
        mostrarFoto(currentIndex + 1);
      } else if (e.key === 'Escape') {
        cerrar();
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initLightbox);
  } else {
    initLightbox();
  }
</script>
