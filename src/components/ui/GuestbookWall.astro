---
---

<!-- Muro de Mensajes Dinámicos -->
<div class="firmas-mensajes-col revelar revelar--retraso-1">
  <div class="mensajes-header">
    <span class="mensajes-conteo" id="mensajes-contador">Deseos para los novios</span>
    <span class="mensajes-luz-badge">✧ En vivo</span>
  </div>

  <div id="muro-deseos-lista" class="muro-deseos-grid" role="feed" aria-label="Dedicatorias de los invitados">
    <!-- Se renderizan automáticamente vía JS con almacenamiento local + pre-cargados -->
  </div>
</div>

<style>
  .firmas-mensajes-col {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .mensajes-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--linea-suave);
  }

  .mensajes-conteo {
    font-family: var(--titulo);
    font-size: 1.35rem;
    color: var(--dorado);
    font-weight: 500;
  }

  .mensajes-luz-badge {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #34D399;
    font-weight: 600;
  }

  .muro-deseos-grid {
    display: grid;
    gap: 1.25rem;
    max-height: 38rem;
    overflow-y: auto;
    padding-right: 0.35rem;
  }

  /* Scrollbar custom para el muro */
  .muro-deseos-grid::-webkit-scrollbar {
    width: 6px;
  }
  .muro-deseos-grid::-webkit-scrollbar-track {
    background: rgba(7, 16, 32, 0.4);
    border-radius: 999px;
  }
  .muro-deseos-grid::-webkit-scrollbar-thumb {
    background: rgba(212, 175, 55, 0.3);
    border-radius: 999px;
  }
  .muro-deseos-grid::-webkit-scrollbar-thumb:hover {
    background: var(--dorado);
  }

  :global(.deseo-card) {
    background: rgba(27, 42, 74, 0.45);
    border: 1px solid var(--linea-suave);
    border-radius: var(--radio-md);
    padding: 1.35rem 1.45rem;
    box-shadow: var(--sombra-suave);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    position: relative;
  }

  :global(.deseo-card:hover) {
    transform: translateY(-4px);
    border-color: var(--dorado);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.45), 0 0 15px rgba(212, 175, 55, 0.2);
  }

  :global(.deseo-card--nuevo) {
    animation: resplandor-nuevo 1s ease-out;
  }

  @keyframes resplandor-nuevo {
    0% { transform: scale(0.96); border-color: #FFE58F; box-shadow: 0 0 30px rgba(212, 175, 55, 0.6); }
    100% { transform: scale(1); }
  }

  :global(.deseo-card__top) {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
  }

  :global(.deseo-autor) {
    font-family: var(--titulo);
    font-size: 1.25rem;
    font-weight: 600;
    color: #FFF4D0;
  }

  :global(.deseo-fecha) {
    font-size: 0.72rem;
    color: var(--plata);
    letter-spacing: 0.05em;
    opacity: 0.8;
  }

  :global(.deseo-texto) {
    font-size: 0.94rem;
    line-height: 1.62;
    color: var(--crema);
    opacity: 0.94;
    margin: 0;
    font-style: italic;
  }

  :global(.deseo-card__pie) {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    margin-top: 0.25rem;
  }

  :global(.btn-reaccion) {
    background: transparent;
    border: none;
    color: var(--dorado);
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.78rem;
    cursor: pointer;
    padding: 0.25rem 0.5rem;
    border-radius: var(--radio-full);
    transition: all 0.2s ease;
  }

  :global(.btn-reaccion:hover) {
    background: rgba(212, 175, 55, 0.15);
    transform: scale(1.08);
  }
</style>

<script>
  import { initialGuestbookWishes, type Deseo } from '../../data/guestbook';

  function setupGuestbook() {
    const contenedor = document.getElementById('muro-deseos-lista');
    const form = document.getElementById('form-guestbook') as HTMLFormElement | null;
    const feedback = document.getElementById('guestbook-feedback');
    const inputAutor = document.getElementById('autor-deseo') as HTMLInputElement | null;
    const inputTexto = document.getElementById('texto-deseo') as HTMLTextAreaElement | null;

    if (!contenedor || !form) return;

    // Cargar deseos desde localStorage combinados con los iniciales
    function obtenerDeseos(): Deseo[] {
      try {
        const guardados = localStorage.getItem('guestbook_deseos');
        if (guardados) {
          const parsed = JSON.parse(guardados);
          if (Array.isArray(parsed) && parsed.length > 0) {
            return parsed;
          }
        }
      } catch {}
      return initialGuestbookWishes;
    }

    function guardarDeseos(deseos: Deseo[]) {
      try {
        localStorage.setItem('guestbook_deseos', JSON.stringify(deseos));
      } catch {}
    }

    function renderizarDeseos(nuevoId?: string) {
      if (!contenedor) return;
      const deseos = obtenerDeseos();
      contenedor.innerHTML = '';

      deseos.forEach(d => {
        const card = document.createElement('article');
        card.className = `deseo-card ${nuevoId === d.id ? 'deseo-card--nuevo' : ''}`;
        card.innerHTML = `
          <div class="deseo-card__top">
            <strong class="deseo-autor">${escapeHtml(d.autor)}</strong>
            <span class="deseo-fecha">${escapeHtml(d.fecha)}</span>
          </div>
          <p class="deseo-texto">«${escapeHtml(d.texto)}»</p>
          <div class="deseo-card__pie">
            <button type="button" class="btn-reaccion" data-like-id="${d.id}" aria-label="Dar cariño a este mensaje">
              <svg class="reaccion-icon-svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>
              <span class="reaccion-count">${d.likes}</span>
            </button>
          </div>
        `;
        contenedor.appendChild(card);
      });

      // Listeners de likes
      contenedor.querySelectorAll('.btn-reaccion').forEach(btn => {
        btn.addEventListener('click', () => {
          const id = btn.getAttribute('data-like-id');
          if (!id) return;
          const deseos = obtenerDeseos();
          const target = deseos.find(item => item.id === id);
          if (target) {
            target.likes += 1;
            guardarDeseos(deseos);
            const countEl = btn.querySelector('.reaccion-count');
            const svgEl = btn.querySelector('.reaccion-icon-svg');
            if (countEl) countEl.textContent = target.likes.toString();
            if (svgEl) {
              svgEl.setAttribute('fill', '#D4AF37');
              svgEl.setAttribute('stroke', '#D4AF37');
            }
          }
        });
      });
    }

    function escapeHtml(str: string): string {
      const div = document.createElement('div');
      div.textContent = str;
      return div.innerHTML;
    }

    // Envío del formulario
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      if (!inputAutor || !inputTexto) return;

      const autor = inputAutor.value.trim();
      const texto = inputTexto.value.trim();
      if (!autor || !texto) return;

      const nuevoDeseo: Deseo = {
        id: 'd_' + Date.now(),
        autor,
        texto,
        fecha: 'Justo ahora',
        likes: 1
      };

      const deseos = obtenerDeseos();
      deseos.unshift(nuevoDeseo);
      guardarDeseos(deseos);

      // Renderizar con destaque
      renderizarDeseos(nuevoDeseo.id);

      // Limpiar y dar feedback
      form.reset();
      if (feedback) {
        feedback.hidden = false;
        setTimeout(() => {
          feedback.hidden = true;
        }, 4000);
      }
    });

    renderizarDeseos();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupGuestbook);
  } else {
    setupGuestbook();
  }
</script>
