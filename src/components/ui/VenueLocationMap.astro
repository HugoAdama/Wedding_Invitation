---
import { venueLocation } from '../../data/schedule';
import WhatsAppIcon from '../icons/WhatsAppIcon.astro';
import TicketIcon from '../icons/TicketIcon.astro';
import CalendarButtons from './CalendarButtons.astro';
---

<div class="mapa-wrapper revelar">
  <div class="mapa-frame">
    <iframe
      title="Ubicación de la Hacienda San José, Km 8 Carretera Arequipa-Yura"
      src={venueLocation.mapEmbedUrl}
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
      allowfullscreen
    ></iframe>
  </div>
  <div class="mapa-info">
    <p>Hacienda San José · Carretera Arequipa–Yura Km 8. El mapa muestra la ubicación de referencia. Pulsa para iniciar tu ruta en tiempo real:</p>

    <!-- Botones de Navegación GPS directa -->
    <div class="mapa-acciones">
      <a
        class="boton-gps boton-gps--google"
        target="_blank"
        rel="noopener noreferrer"
        href="https://www.google.com/maps/search/?api=1&query=Hacienda+San+Jose+Carretera+Arequipa+Yura+Km+8+Arequipa"
        aria-label="Abrir ruta en Google Maps"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
          <circle cx="12" cy="10" r="3"></circle>
        </svg>
        <span>Abrir en Google Maps</span>
      </a>

      <a
        class="boton-gps boton-gps--waze"
        target="_blank"
        rel="noopener noreferrer"
        href="https://waze.com/ul?q=Hacienda+San+Jose+Arequipa+Yura&navigate=yes"
        aria-label="Abrir ruta en Waze"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 2C6.48 2 2 6.48 2 12c0 1.54.36 2.98.97 4.29L2 22l5.71-.97C9.02 21.64 10.46 22 12 22c5.52 0 10-4.48 10-10S17.52 2 12 2zm-2.5 12a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3zm5 0a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3z"/>
        </svg>
        <span>Abrir en Waze</span>
      </a>

      <a
        class="boton-gps boton-gps--wa"
        target="_blank"
        rel="noopener noreferrer"
        href={`https://wa.me/51999777666?text=${encodeURIComponent(venueLocation.whatsappLocationText)}`}
        aria-label="Pedir ubicación exacta por WhatsApp"
      >
        <WhatsAppIcon size={18} />
        <span>Coordenadas por WhatsApp</span>
      </a>

      <button
        type="button"
        class="boton-gps boton-gps--pase"
        id="btn-ver-pase-digital"
        aria-label="Ver Pase Digital de Asistencia con código QR"
      >
        <TicketIcon size={18} />
        <span>Pase Digital con QR</span>
      </button>
    </div>

    <!-- Agendar al calendario -->
    <div class="seccion-cal-wrap">
      <p class="cal-hint">¿Deseas guardar la fecha en tu calendario?</p>
      <CalendarButtons variant="seccion" />
    </div>
  </div>
</div>

<style>
  .mapa-wrapper {
    max-width: 54rem;
    margin: 0 auto;
    text-align: center;
  }

  .mapa-frame {
    aspect-ratio: 16 / 8;
    min-height: 16rem;
    overflow: hidden;
    border: 1px solid var(--linea);
    border-radius: var(--radio-md);
    box-shadow: var(--sombra-suave);
    margin-bottom: 1.5rem;
    background: var(--noche);
  }

  .mapa-frame iframe {
    width: 100%;
    height: 100%;
    border: 0;
  }

  .mapa-info p {
    color: var(--plata);
    font-size: 0.95rem;
    max-width: 36rem;
    margin: 0 auto 1.25rem;
    line-height: 1.6;
  }

  .mapa-acciones {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-bottom: 2rem;
  }

  .boton-gps {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.65rem 1.2rem;
    border-radius: var(--radio-md);
    font-size: 0.88rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.22s ease;
    cursor: pointer;
  }

  .boton-gps--google {
    background: rgba(212, 175, 55, 0.15);
    color: #FFF2A8;
    border: 1px solid rgba(212, 175, 55, 0.4);
  }

  .boton-gps--google:hover {
    background: rgba(212, 175, 55, 0.3);
    border-color: #D4AF37;
    transform: translateY(-2px);
    box-shadow: 0 4px 15px rgba(212, 175, 55, 0.25);
  }

  .boton-gps--waze {
    background: rgba(51, 153, 255, 0.15);
    color: #99CCFF;
    border: 1px solid rgba(51, 153, 255, 0.4);
  }

  .boton-gps--waze:hover {
    background: rgba(51, 153, 255, 0.25);
    border-color: #3399FF;
    transform: translateY(-2px);
    box-shadow: 0 4px 15px rgba(51, 153, 255, 0.25);
  }

  .boton-gps--wa {
    background: rgba(37, 211, 102, 0.15);
    color: #80ECA0;
    border: 1px solid rgba(37, 211, 102, 0.4);
  }

  .boton-gps--wa:hover {
    background: rgba(37, 211, 102, 0.25);
    border-color: #25D366;
    transform: translateY(-2px);
    box-shadow: 0 4px 15px rgba(37, 211, 102, 0.25);
  }

  .boton-gps--pase {
    background: linear-gradient(135deg, rgba(212, 175, 55, 0.25) 0%, rgba(163, 92, 126, 0.25) 100%);
    color: #FFF6D6;
    border: 1px solid var(--dorado);
    box-shadow: 0 4px 15px rgba(212, 175, 55, 0.2);
  }

  .boton-gps--pase:hover {
    background: linear-gradient(135deg, rgba(212, 175, 55, 0.4) 0%, rgba(163, 92, 126, 0.4) 100%);
    border-color: #FFE58F;
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(212, 175, 55, 0.35);
  }

  .seccion-cal-wrap {
    padding-top: 1.25rem;
    border-top: 1px solid var(--linea-suave);
  }

  .cal-hint {
    font-size: 0.88rem !important;
    color: var(--dorado) !important;
    margin-bottom: 0.4rem !important;
  }
</style>

<script>
  function setupPaseTrigger() {
    const btn = document.getElementById('btn-ver-pase-digital');
    if (!btn) return;
    btn.addEventListener('click', () => {
      window.dispatchEvent(new CustomEvent('abrir-pase-digital'));
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupPaseTrigger);
  } else {
    setupPaseTrigger();
  }
</script>
