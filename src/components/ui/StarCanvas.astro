---
// Componente de lienzo interactivo de constelaciones y polvo de estrellas
---
<canvas id="cielo-canvas" class="cielo-canvas" aria-hidden="true"></canvas>

<style>
  .cielo-canvas {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    pointer-events: none;
    z-index: 0;
    opacity: 0.85;
  }

  @media (prefers-reduced-motion: reduce) {
    .cielo-canvas {
      display: none;
    }
  }
</style>

<script>
  function iniciarLienzoEstelar() {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const canvas = document.getElementById('cielo-canvas') as HTMLCanvasElement | null;
    if (!canvas) return;

    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    let width = 0;
    let height = 0;
    let animationFrameId: number;

    const mouse = {
      x: -1000,
      y: -1000,
      radius: 140
    };

    interface Estrella {
      x: number;
      y: number;
      vx: number;
      vy: number;
      radio: number;
      baseAlpha: number;
      alpha: number;
      color: string;
      fase: number;
    }

    let estrellas: Estrella[] = [];

    function redimensionar() {
      if (!canvas) return;
      const dpr = window.devicePixelRatio || 1;
      width = window.innerWidth;
      height = window.innerHeight;
      canvas.width = width * dpr;
      canvas.height = height * dpr;
      if (ctx) ctx.scale(dpr, dpr);

      crearEstrellas();
    }

    let activo = true;

    function crearEstrellas() {
      estrellas = [];
      // Cantidad balanceada según tamaño de pantalla (optimizado para batería en móviles)
      const esMovil = width < 768;
      const divisor = esMovil ? 22000 : 14000;
      const maxEstrellas = esMovil ? 45 : 75;
      const cantidad = Math.min(Math.floor((width * height) / divisor), maxEstrellas);

      for (let i = 0; i < cantidad; i++) {
        const isGold = i % 5 === 0;
        const baseAlpha = 0.25 + Math.random() * 0.55;
        estrellas.push({
          x: Math.random() * width,
          y: Math.random() * height,
          vx: (Math.random() - 0.5) * 0.22,
          vy: (Math.random() - 0.5) * 0.22,
          radio: Math.random() * 1.5 + (isGold ? 1.2 : 0.8),
          baseAlpha,
          alpha: baseAlpha,
          color: isGold ? '#D4AF37' : '#FFFFFF',
          fase: Math.random() * Math.PI * 2
        });
      }
    }

    function animar() {
      if (!ctx || !activo) return;
      ctx.clearRect(0, 0, width, height);

      // Dibujar y actualizar estrellas
      for (let i = 0; i < estrellas.length; i++) {
        const e = estrellas[i];

        // Movimiento suave
        e.x += e.vx;
        e.y += e.vy;

        // Rebote en bordes
        if (e.x < 0) e.x = width;
        if (e.x > width) e.x = 0;
        if (e.y < 0) e.y = height;
        if (e.y > height) e.y = 0;

        // Parpadeo sutil
        e.fase += 0.025;
        e.alpha = e.baseAlpha + Math.sin(e.fase) * 0.2;

        ctx.beginPath();
        ctx.arc(e.x, e.y, e.radio, 0, Math.PI * 2);
        ctx.fillStyle = e.color === '#D4AF37'
          ? `rgba(212, 175, 55, ${Math.max(0.1, e.alpha)})`
          : `rgba(255, 255, 255, ${Math.max(0.1, e.alpha)})`;
        ctx.fill();

        // Conexiones de constelación con el cursor
        const dxMouse = mouse.x - e.x;
        const dyMouse = mouse.y - e.y;
        const distMouse = Math.sqrt(dxMouse * dxMouse + dyMouse * dyMouse);

        if (distMouse < mouse.radius) {
          const lineaAlpha = (1 - distMouse / mouse.radius) * 0.35;
          ctx.beginPath();
          ctx.moveTo(e.x, e.y);
          ctx.lineTo(mouse.x, mouse.y);
          ctx.strokeStyle = `rgba(212, 175, 55, ${lineaAlpha})`;
          ctx.lineWidth = 0.8;
          ctx.stroke();
        }

        // Conexiones entre estrellas cercanas (efecto constelaciones)
        for (let j = i + 1; j < estrellas.length; j++) {
          const e2 = estrellas[j];
          const dx = e.x - e2.x;
          const dy = e.y - e2.y;
          const dist = Math.sqrt(dx * dx + dy * dy);

          if (dist < 90) {
            const lineaAlpha = (1 - dist / 90) * 0.14;
            ctx.beginPath();
            ctx.moveTo(e.x, e.y);
            ctx.lineTo(e2.x, e2.y);
            ctx.strokeStyle = `rgba(212, 175, 55, ${lineaAlpha})`;
            ctx.lineWidth = 0.6;
            ctx.stroke();
          }
        }
      }

      animationFrameId = requestAnimationFrame(animar);
    }

    let resizeTimer: number;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(redimensionar, 150);
    });

    window.addEventListener('mousemove', (e) => {
      mouse.x = e.clientX;
      mouse.y = e.clientY;
    });

    window.addEventListener('mouseleave', () => {
      mouse.x = -1000;
      mouse.y = -1000;
    });

    // Pausar animación cuando la pestaña está en segundo plano para ahorrar batería
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        activo = false;
        cancelAnimationFrame(animationFrameId);
      } else {
        activo = true;
        animationFrameId = requestAnimationFrame(animar);
      }
    });

    redimensionar();
    animar();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', iniciarLienzoEstelar);
  } else {
    iniciarLienzoEstelar();
  }
</script>
