---
// Componente de botones de calendario (Google Calendar y descarga de archivo .ics)
interface Props {
  variant?: 'hero' | 'seccion';
}

const { variant = 'hero' } = Astro.props;

const googleCalendarUrl = "https://calendar.google.com/calendar/render?action=TEMPLATE" +
  "&text=" + encodeURIComponent("Daniela & Rodrigo · Boda bajo las estrellas") +
  "&dates=20270612T223000Z/20270613T090000Z" +
  "&details=" + encodeURIComponent("Ceremonia Civil & Simbólica (5:30 p. m.) y Recepción & Fiesta bajo las estrellas (7:30 p. m.) en Hacienda San José, Arequipa. ¡Celebremos juntos!") +
  "&location=" + encodeURIComponent("Hacienda San José, Km 8, Carretera Arequipa-Yura, Arequipa, Perú");
---

<div class={`calendario-acciones calendario-acciones--${variant}`}>
  <a
    href={googleCalendarUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="btn-cal btn-cal--google"
    aria-label="Agregar boda a Google Calendar"
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
      <line x1="16" y1="2" x2="16" y2="6"></line>
      <line x1="8" y1="2" x2="8" y2="6"></line>
      <line x1="3" y1="10" x2="21" y2="10"></line>
      <circle cx="12" cy="15" r="1.5" fill="currentColor"></circle>
    </svg>
    <span>Google Calendar</span>
  </a>

  <button
    type="button"
    class="btn-cal btn-cal--ics btn-descargar-ics"
    aria-label="Descargar archivo de calendario para Apple Calendar o Outlook"
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
      <polyline points="7 10 12 15 17 10"></polyline>
      <line x1="12" y1="15" x2="12" y2="3"></line>
    </svg>
    <span>Apple / Outlook (.ics)</span>
  </button>
</div>

<style>
  .calendario-acciones {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    margin-top: 1rem;
  }

  .btn-cal {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.45rem 0.95rem;
    font-size: 0.8rem;
    font-weight: 500;
    font-family: var(--fuente-cuerpo);
    border-radius: 9999px;
    background: rgba(18, 26, 47, 0.7);
    color: var(--plata-estelar);
    border: 1px solid rgba(212, 175, 55, 0.35);
    text-decoration: none;
    cursor: pointer;
    transition: all 0.22s ease;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .btn-cal:hover {
    color: #FFF2A8;
    border-color: #D4AF37;
    background: rgba(212, 175, 55, 0.15);
    box-shadow: 0 0 14px rgba(212, 175, 55, 0.3);
    transform: translateY(-1px);
  }

  .calendario-acciones--hero .btn-cal {
    font-size: 0.78rem;
    padding: 0.4rem 0.85rem;
  }
</style>

<script>
  function initIcsDownload() {
    const btns = document.querySelectorAll('.btn-descargar-ics');
    btns.forEach(btn => {
      btn.addEventListener('click', () => {
        const icsContent = [
          'BEGIN:VCALENDAR',
          'VERSION:2.0',
          'PRODID:-//Daniela y Rodrigo//Boda Bajo las Estrellas//ES',
          'CALSCALE:GREGORIAN',
          'METHOD:PUBLISH',
          'BEGIN:VEVENT',
          'UID:boda-daniela-rodrigo-2027@daniyrodrigo.pe',
          'DTSTAMP:20270612T173000Z',
          'DTSTART:20270612T223000Z',
          'DTEND:20270613T090000Z',
          'SUMMARY:Boda Daniela & Rodrigo · Bajo las estrellas',
          'DESCRIPTION:Ceremonia Civil & Simbólica (5:30 p. m.) y Recepción & Fiesta (7:30 p. m.) en Hacienda San José, Carretera Arequipa-Yura Km 8, Arequipa. ¡Te esperamos para celebrar bajo las estrellas!',
          'LOCATION:Hacienda San José, Km 8, Carretera Arequipa–Yura, Arequipa, Perú',
          'STATUS:CONFIRMED',
          'END:VEVENT',
          'END:VCALENDAR'
        ].join('\r\n');

        const blob = new Blob([icsContent], { type: 'text/calendar;charset=utf-8' });
        const link = document.createElement('a');
        link.href = window.URL.createObjectURL(blob);
        link.setAttribute('download', 'boda-daniela-y-rodrigo-2027.ics');
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initIcsDownload);
  } else {
    initIcsDownload();
  }
</script>
