---
import WhatsAppIcon from '../icons/WhatsAppIcon.astro';
import CheckCircleIcon from '../icons/CheckIcon.astro';
import SparklesIcon from '../icons/SparklesIcon.astro';
import HeartIcon from '../icons/HeartIcon.astro';
import MusicIcon from '../icons/MusicIcon.astro';
import { weddingData } from '../../data/wedding';

interface Props {
  whatsappNumber?: string;
}

const { whatsappNumber = weddingData.whatsappNumber } = Astro.props;
---

<div class="rsvp-form-card">
  <div class="form-card__header">
    <h3 class="form-card__titulo">Confirmación de Asistencia</h3>
    <p class="form-card__sub">
      Al enviar se abrirá WhatsApp con tu respuesta estructurada para confirmación inmediata.
    </p>
  </div>

  <form class="rsvp-form" id="rsvp-form" data-phone={whatsappNumber}>
    <!-- Campo: Nombre y apellido -->
    <div class="campo">
      <label for="nombre">
        <span>Nombre y apellido</span>
        <span class="campo__requerido">*</span>
      </label>
      <div class="input-wrapper">
        <input
          id="nombre"
          name="nombre"
          type="text"
          autocomplete="name"
          placeholder="Ej. Carmen Velarde"
          required
        />
      </div>
    </div>

    <!-- Selector de Asistencia interactivo (Tarjetas Toggle) -->
    <div class="campo">
      <label>
        <span>¿Podrás acompañarnos?</span>
        <span class="campo__requerido">*</span>
      </label>
      <div class="asistencia-toggle-grid">
        <label class="asistencia-card asistencia-card--si activo" id="label-asiste-si">
          <input
            type="radio"
            name="asistencia"
            value="si"
            checked
            class="sr-only"
            id="radio-asiste-si"
          />
          <div class="asistencia-card__icono">
            <SparklesIcon size={20} class="text-[#D4AF37]" />
          </div>
          <div class="asistencia-card__texto">
            <span class="asistencia-card__titulo">¡Sí, asistiré!</span>
            <span class="asistencia-card__sub">Bajo las estrellas</span>
          </div>
          <div class="asistencia-card__check">
            <CheckCircleIcon size={18} />
          </div>
        </label>

        <label class="asistencia-card asistencia-card--no" id="label-asiste-no">
          <input
            type="radio"
            name="asistencia"
            value="no"
            class="sr-only"
            id="radio-asiste-no"
          />
          <div class="asistencia-card__icono">
            <HeartIcon size={20} class="text-[#A5B4FC]" />
          </div>
          <div class="asistencia-card__texto">
            <span class="asistencia-card__titulo">No podré asistir</span>
            <span class="asistencia-card__sub">Con el corazón</span>
          </div>
          <div class="asistencia-card__check">
            <CheckCircleIcon size={18} />
          </div>
        </label>
      </div>
    </div>

    <!-- Campos condicionales para SI asiste -->
    <div id="bloque-asiste-si" class="bloque-condicional">
      <div class="campo-grupo">
        <!-- Contador de pases -->
        <div class="campo">
          <label for="personas">Número de pases / personas</label>
          <div class="stepper-wrapper">
            <button
              type="button"
              id="btn-menos-pases"
              class="stepper-btn"
              aria-label="Disminuir pases"
            >-</button>
            <input
              id="personas"
              name="personas"
              type="number"
              min="1"
              max="10"
              value="1"
              readonly
              class="stepper-input"
            />
            <button
              type="button"
              id="btn-mas-pases"
              class="stepper-btn"
              aria-label="Aumentar pases"
            >+</button>
          </div>
        </div>

        <!-- Menú -->
        <div class="campo">
          <label for="menu">Preferencia de menú</label>
          <select id="menu" name="menu" class="select-estilizado">
            <option value="Tradicional arequipeño">Tradicional arequipeño</option>
            <option value="Vegetariano">Menú vegetariano</option>
            <option value="Vegano">Menú vegano</option>
            <option value="Infantil">Menú infantil</option>
          </select>
        </div>
      </div>

      <!-- Alergias o restricciones -->
      <div class="campo">
        <label for="restricciones">Alergias o restricciones alimentarias</label>
        <input
          id="restricciones"
          name="restricciones"
          type="text"
          placeholder="Opcional: celiaquía, alergia a mariscos, frutos secos..."
        />
      </div>

      <!-- Canción para la fiesta -->
      <div class="campo">
        <label for="cancion" class="label-con-icono">
          <MusicIcon size={15} class="text-[#D4AF37]" />
          <span>Canción que te hará bailar toda la noche (opcional)</span>
        </label>
        <input
          id="cancion"
          name="cancion"
          type="text"
          placeholder="Ej. La Vie en Rose - Canción favorita"
        />
      </div>
    </div>

    <!-- Campos condicionales para NO asiste -->
    <div id="bloque-asiste-no" class="bloque-condicional" hidden>
      <div class="campo">
        <label for="mensaje-ausencia">Mensaje para los novios (opcional)</label>
        <textarea
          id="mensaje-ausencia"
          name="mensaje-ausencia"
          rows="3"
          placeholder="Déjanos unas palabras de cariño o tus mejores deseos para nuestro gran día..."
        ></textarea>
      </div>
    </div>

    <!-- Botón de Envío WhatsApp de Lujo -->
    <div class="form-submit-wrapper">
      <button class="boton-whatsapp-submit" type="submit" id="btn-submit-rsvp">
        <WhatsAppIcon size={22} class="whatsapp-btn-icon" />
        <span id="texto-btn-submit">Confirmar Asistencia por WhatsApp</span>
      </button>
      <p class="submit-garantia">
        Se abrirá la aplicación de WhatsApp con tu respuesta redactada.
      </p>
    </div>

    <p class="rsvp-estado" id="estado" role="status" aria-live="polite"></p>
  </form>
</div>

<style>
  .rsvp-form-card {
    background: radial-gradient(circle at top right, rgba(74, 59, 107, 0.25) 0%, rgba(11, 29, 58, 0.85) 100%);
    border: 1px solid var(--linea);
    border-radius: var(--radio-lg);
    padding: clamp(1.75rem, 4vw, 2.75rem);
    box-shadow: 0 16px 45px rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .rsvp-form-card:hover {
    border-color: rgba(212, 175, 55, 0.65);
    box-shadow: 0 20px 55px rgba(0, 0, 0, 0.6), 0 0 30px rgba(212, 175, 55, 0.2);
  }

  .form-card__header {
    margin-bottom: 1.75rem;
  }

  .form-card__titulo {
    font-family: var(--titulo);
    font-size: clamp(1.8rem, 3.2vw, 2.3rem);
    color: #FFF2A8;
    margin: 0 0 0.4rem;
  }

  .form-card__sub {
    font-size: 0.96rem;
    color: var(--crema);
    opacity: 0.9;
    line-height: 1.55;
    margin: 0;
  }

  .rsvp-form {
    display: grid;
    gap: 1.4rem;
  }

  .campo {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    text-align: left;
  }

  .campo label {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--crema);
    letter-spacing: 0.02em;
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .campo__requerido {
    color: var(--dorado);
    font-weight: bold;
  }

  .label-con-icono {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .input-wrapper {
    position: relative;
  }

  .campo input,
  .campo select,
  .campo textarea {
    width: 100%;
    padding: 0.85rem 1.15rem;
    font-family: var(--cuerpo);
    font-size: 0.98rem;
    color: var(--crema);
    background: rgba(7, 16, 32, 0.85);
    border: 1px solid var(--linea-suave);
    border-radius: var(--radio-sm);
    transition: border-color 0.25s ease, box-shadow 0.25s ease, background 0.25s ease;
  }

  .campo input:focus,
  .campo select:focus,
  .campo textarea:focus {
    outline: none;
    border-color: var(--dorado);
    background: rgba(7, 16, 32, 0.95);
    box-shadow: 0 0 15px rgba(212, 175, 55, 0.3);
  }

  .campo input::placeholder,
  .campo textarea::placeholder {
    color: var(--plata);
    opacity: 0.6;
  }

  /* Selector de Asistencia (Toggle Cards) */
  .asistencia-toggle-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .asistencia-card {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 1rem 1.15rem;
    background: rgba(7, 16, 32, 0.7);
    border: 1.5px solid var(--linea-suave);
    border-radius: var(--radio-md);
    cursor: pointer;
    transition: transform 0.25s ease, border-color 0.25s ease, background 0.25s ease, box-shadow 0.25s ease;
  }

  .asistencia-card:hover {
    transform: translateY(-2px);
    border-color: rgba(212, 175, 55, 0.5);
  }

  .asistencia-card.activo {
    background: rgba(27, 42, 74, 0.85);
    border-color: var(--dorado);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.4), 0 0 16px rgba(212, 175, 55, 0.25);
  }

  .asistencia-card--no.activo {
    border-color: #818CF8;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.4), 0 0 16px rgba(129, 140, 248, 0.25);
  }

  .asistencia-card__icono {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.05);
    flex-shrink: 0;
  }

  .asistencia-card__texto {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    flex: 1;
  }

  .asistencia-card__titulo {
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--crema);
  }

  .asistencia-card__sub {
    font-size: 0.75rem;
    color: var(--plata);
    opacity: 0.85;
  }

  .asistencia-card__check {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.25rem;
    height: 1.25rem;
    border-radius: 50%;
    color: var(--noche);
    background: var(--dorado);
    opacity: 0;
    transform: scale(0.6);
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .asistencia-card.activo .asistencia-card__check {
    opacity: 1;
    transform: scale(1);
  }

  .asistencia-card--no.activo .asistencia-card__check {
    background: #818CF8;
  }

  /* Bloque condicional */
  .bloque-condicional {
    display: grid;
    gap: 1.25rem;
    animation: fadeIn 0.3s ease;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .campo-grupo {
    display: grid;
    gap: 1.25rem;
  }

  @media (min-width: 580px) {
    .campo-grupo {
      grid-template-columns: 1fr 1.25fr;
    }
  }

  /* Stepper de personas */
  .stepper-wrapper {
    display: flex;
    align-items: center;
    background: rgba(7, 16, 32, 0.85);
    border: 1px solid var(--linea-suave);
    border-radius: var(--radio-sm);
    overflow: hidden;
  }

  .stepper-btn {
    width: 3rem;
    height: 2.85rem;
    background: rgba(255, 255, 255, 0.04);
    border: none;
    color: var(--dorado);
    font-size: 1.4rem;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .stepper-btn:hover {
    background: rgba(212, 175, 55, 0.15);
    color: #ffffff;
  }

  .stepper-input {
    border: none !important;
    background: transparent !important;
    text-align: center;
    font-weight: 600;
    font-size: 1.15rem;
    color: var(--crema);
    padding: 0;
    width: 100%;
    box-shadow: none !important;
  }

  /* Submit WhatsApp de Alta Gama */
  .form-submit-wrapper {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    margin-top: 0.5rem;
  }

  .boton-whatsapp-submit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    width: 100%;
    padding: 1.1rem 1.85rem;
    font-family: var(--cuerpo);
    font-size: 1.05rem;
    font-weight: 600;
    color: #071020;
    background: linear-gradient(135deg, #E6CA65 0%, #D4AF37 50%, #C49B28 100%);
    border: 1px solid #FFE680;
    border-radius: var(--radio-full);
    cursor: pointer;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.4), 0 0 25px rgba(212, 175, 55, 0.35);
    transition: transform 0.25s ease, box-shadow 0.25s ease, filter 0.25s ease;
  }

  .boton-whatsapp-submit:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.5), 0 0 35px rgba(212, 175, 55, 0.55);
    filter: brightness(1.05);
  }

  .boton-whatsapp-submit:active {
    transform: translateY(0);
  }

  .whatsapp-btn-icon {
    flex-shrink: 0;
  }

  .submit-garantia {
    font-size: 0.78rem;
    color: var(--plata);
    opacity: 0.75;
    text-align: center;
    margin: 0;
  }

  .rsvp-estado {
    min-height: 1.5rem;
    margin: 0;
    font-size: 0.92rem;
    color: var(--dorado);
    text-align: center;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>

<script>
  import { lanzarConfetiCelestial } from '../../utils/confetti';
  import { buildRsvpWhatsAppMessage, buildWhatsAppUrl } from '../../utils/whatsapp';

  function setupRSVP() {
    const form = document.getElementById("rsvp-form") as HTMLFormElement | null;
    const estado = document.getElementById("estado");
    const radioSi = document.getElementById("radio-asiste-si") as HTMLInputElement | null;
    const radioNo = document.getElementById("radio-asiste-no") as HTMLInputElement | null;
    const labelSi = document.getElementById("label-asiste-si");
    const labelNo = document.getElementById("label-asiste-no");
    const bloqueSi = document.getElementById("bloque-asiste-si");
    const bloqueNo = document.getElementById("bloque-asiste-no");
    const personasInput = document.getElementById("personas") as HTMLInputElement | null;
    const nombreInput = document.getElementById("nombre") as HTMLInputElement | null;
    const btnMenos = document.getElementById("btn-menos-pases");
    const btnMas = document.getElementById("btn-mas-pases");
    const textoBtnSubmit = document.getElementById("texto-btn-submit");

    if (!form) return;

    // Prellenar datos desde URL si existen (?para= y ?pases=)
    try {
      const urlParams = new URLSearchParams(window.location.search);
      const para = urlParams.get('para');
      const pases = urlParams.get('pases');
      if (para && nombreInput && !nombreInput.value) {
        nombreInput.value = para;
      }
      if (pases && personasInput) {
        const numPases = parseInt(pases, 10);
        if (!isNaN(numPases) && numPases >= 1 && numPases <= 10) {
          personasInput.value = numPases.toString();
        }
      }
    } catch {
      // Ignorar
    }

    // Control de Toggle Asistencia (Sí / No)
    function actualizarAsistencia(asiste: boolean) {
      if (asiste) {
        if (radioSi) radioSi.checked = true;
        labelSi?.classList.add("activo");
        labelNo?.classList.remove("activo");
        if (bloqueSi) bloqueSi.hidden = false;
        if (bloqueNo) bloqueNo.hidden = true;
        if (textoBtnSubmit) {
          textoBtnSubmit.textContent = "Confirmar Asistencia por WhatsApp";
        }
      } else {
        if (radioNo) radioNo.checked = true;
        labelNo?.classList.add("activo");
        labelSi?.classList.remove("activo");
        if (bloqueSi) bloqueSi.hidden = true;
        if (bloqueNo) bloqueNo.hidden = false;
        if (textoBtnSubmit) {
          textoBtnSubmit.textContent = "Enviar mensaje a los novios por WhatsApp";
        }
      }
    }

    labelSi?.addEventListener("click", () => actualizarAsistencia(true));
    labelNo?.addEventListener("click", () => actualizarAsistencia(false));

    // Stepper de Pases (+ y -)
    btnMenos?.addEventListener("click", () => {
      if (!personasInput) return;
      const actual = parseInt(personasInput.value, 10) || 1;
      if (actual > 1) {
        personasInput.value = (actual - 1).toString();
      }
    });

    btnMas?.addEventListener("click", () => {
      if (!personasInput) return;
      const actual = parseInt(personasInput.value, 10) || 1;
      if (actual < 10) {
        personasInput.value = (actual + 1).toString();
      }
    });

    // Envío del Formulario hacia WhatsApp
    form.addEventListener("submit", function (e) {
      e.preventDefault();
      const formData = new FormData(form);
      const asiste = formData.get("asistencia") === "si";
      const nombre = String(formData.get("nombre") || "").trim();
      const phone = form.getAttribute("data-phone") || "51999777666";

      const personas = String(formData.get("personas") || "1");
      const menu = String(formData.get("menu") || "");
      const restricciones = String(formData.get("restricciones") || "").trim();
      const cancion = String(formData.get("cancion") || "").trim();
      const mensajeAusencia = String(formData.get("mensaje-ausencia") || "").trim();

      const texto = buildRsvpWhatsAppMessage({
        asiste,
        nombre,
        personas,
        menu,
        restricciones,
        cancion,
        mensajeAusencia
      });

      if (asiste) {
        try {
          if ('vibrate' in navigator) navigator.vibrate([40, 30, 60]);
        } catch {}
        lanzarConfetiCelestial();
      }

      const url = buildWhatsAppUrl(phone, texto);
      setTimeout(() => {
        window.open(url, "_blank", "noopener,noreferrer");
      }, asiste ? 450 : 100);

      if (estado) {
        estado.textContent = "¡Listo! Se ha abierto WhatsApp con tu confirmación preparada.";
      }
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupRSVP);
  } else {
    setupRSVP();
  }
</script>
