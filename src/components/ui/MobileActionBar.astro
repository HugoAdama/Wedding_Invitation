---
import MapPinIcon from '../icons/MapPinIcon.astro';
import HeartIcon from '../icons/HeartIcon.astro';
import MailIcon from '../icons/MailIcon.astro';
import TicketIcon from '../icons/TicketIcon.astro';
---

<!-- Barra móvil fija de acceso rápido para invitados -->
<aside class="barra-movil" aria-label="Acciones rápidas de la invitación">
  <div class="barra-movil__contenedor">
    <a
      href="https://maps.google.com/?q=Hacienda+San+Jose+Arequipa+Yura"
      target="_blank"
      rel="noopener noreferrer"
      class="barra-btn"
      aria-label="Abrir mapa de ubicación en Google Maps"
    >
      <div class="barra-btn__icono">
        <MapPinIcon size={18} />
      </div>
      <span class="barra-btn__texto">Ubicación</span>
    </a>

    <button
      type="button"
      id="btn-movil-pase"
      class="barra-btn"
      aria-label="Ver pase digital con código QR"
    >
      <div class="barra-btn__icono">
        <TicketIcon size={18} />
      </div>
      <span class="barra-btn__texto">Pase QR</span>
    </button>

    <a
      href="#confirmar"
      class="barra-btn barra-btn--destacado"
      aria-label="Ir a confirmar asistencia a la boda"
    >
      <div class="barra-btn__icono">
        <HeartIcon size={18} />
      </div>
      <span class="barra-btn__texto">Confirmar</span>
    </a>

    <button
      type="button"
      id="btn-movil-reabrir-sobre"
      class="barra-btn"
      aria-label="Ver sobre nupcial y sello de cera"
    >
      <div class="barra-btn__icono">
        <MailIcon size={18} />
      </div>
      <span class="barra-btn__texto">Sobre</span>
    </button>
  </div>
</aside>

<style>
  .barra-movil {
    display: block;
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 900;
    background: rgba(11, 29, 58, 0.92);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-top: 1px solid rgba(212, 175, 55, 0.35);
    box-shadow: 0 -8px 25px rgba(0, 0, 0, 0.5);
    padding: 0.5rem 1rem max(0.5rem, env(safe-area-inset-bottom));
  }

  @media (min-width: 768px) {
    .barra-movil {
      display: none !important;
    }
  }

  .barra-movil__contenedor {
    display: flex;
    align-items: center;
    justify-content: space-around;
    max-width: 28rem;
    margin: 0 auto;
    gap: 0.5rem;
  }

  .barra-btn {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.2rem;
    background: transparent;
    border: none;
    color: var(--crema, #F5EFE6);
    text-decoration: none;
    padding: 0.35rem 0.75rem;
    border-radius: var(--radio-md, 8px);
    cursor: pointer;
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.03em;
    transition: all 0.2s ease;
    flex: 1;
    min-height: 48px;
  }

  .barra-btn:active {
    transform: scale(0.96);
  }

  .barra-btn__icono {
    color: var(--dorado, #D4AF37);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Botón RSVP Principal */
  .barra-btn--destacado {
    background: linear-gradient(135deg, rgba(212, 175, 55, 0.22), rgba(163, 92, 126, 0.22));
    border: 1px solid rgba(212, 175, 55, 0.6);
    color: #FFF6D6;
    font-weight: 600;
    box-shadow: 0 0 12px rgba(212, 175, 55, 0.25);
    position: relative;
    overflow: hidden;
  }

  .barra-btn--destacado .barra-btn__icono {
    color: #FFE58F;
    animation: latido-suave 2s infinite ease-in-out;
  }

  @keyframes latido-suave {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.15); }
  }
</style>

<script>
  function setupMobileActionBar() {
    const btnSobre = document.getElementById('btn-movil-reabrir-sobre');
    const btnPase = document.getElementById('btn-movil-pase');

    btnSobre?.addEventListener('click', () => {
      window.dispatchEvent(new CustomEvent('reabrir-sobre'));
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });

    btnPase?.addEventListener('click', () => {
      window.dispatchEvent(new CustomEvent('abrir-pase-digital'));
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupMobileActionBar);
  } else {
    setupMobileActionBar();
  }
</script>
