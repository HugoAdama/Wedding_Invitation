---
interface Props {
  class?: string;
  size?: number | string;
}

const { class: className = "w-6 h-6", size = 24 } = Astro.props;
---
<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
>
  <!-- Barrel -->
  <path d="M7 6l13-3 2 4-13 3z" />
  <path d="M4 14l3-5 3 2-3 5z" />
  <!-- Tripod -->
  <line x1="8.5" y1="12.5" x2="4" y2="21" />
  <line x1="8.5" y1="12.5" x2="13" y2="21" />
  <line x1="8.5" y1="12.5" x2="8.5" y2="21" />
</svg>
