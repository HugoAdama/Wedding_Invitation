---
interface Props {
  class?: string;
  size?: number | string;
}

const { class: className = "w-6 h-6", size = 24 } = Astro.props;
---
<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
>
  <path d="M3 3v18h18" />
  <path d="M7 16v-4" />
  <path d="M12 16V8" />
  <path d="M17 16v-9" />
  <circle cx="17" cy="7" r="1.5" fill="currentColor" />
  <circle cx="12" cy="8" r="1.5" fill="currentColor" />
  <circle cx="7" cy="12" r="1.5" fill="currentColor" />
</svg>
