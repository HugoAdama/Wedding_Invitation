---
interface Props {
  class?: string;
  size?: number | string;
}

const { class: className = "w-6 h-6", size = 24 } = Astro.props;
---
<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
>
  <circle cx="12" cy="7" r="3.5" />
  <!-- Tuxedo / bow-tie -->
  <path d="M5 21v-3a4 4 0 0 1 4-4h6a4 4 0 0 1 4 4v3" />
  <path d="M10 14.5l2 2 2-2" />
  <!-- Bowtie -->
  <polygon points="10,13.5 14,13.5 13,15 14,16.5 10,16.5 11,15" fill="currentColor" opacity="0.3" />
  <circle cx="12" cy="15" r="0.8" fill="currentColor" />
</svg>
