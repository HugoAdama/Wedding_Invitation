---
interface Props {
  class?: string;
  size?: number | string;
}

const { class: className = "w-6 h-6", size = 24 } = Astro.props;
---
<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
>
  <!-- Veil and crown -->
  <path d="M7 6a5 5 0 0 1 10 0v2H7V6z" stroke-dasharray="2 1.5" />
  <circle cx="12" cy="9" r="3.5" />
  <!-- Tiara / diadem -->
  <path d="M10 5.5l2-1.5 2 1.5" />
  <!-- Dress & shoulders -->
  <path d="M6 21v-3a4 4 0 0 1 4-4h4a4 4 0 0 1 4 4v3" />
  <path d="M9 14l3 4 3-4" />
  <circle cx="12" cy="18" r="0.75" fill="currentColor" />
</svg>
