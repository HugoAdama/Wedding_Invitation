---
interface Props {
  class?: string;
  size?: number | string;
}

const { class: className = "w-6 h-6", size = 24 } = Astro.props;
---
<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
>
  <ellipse cx="12" cy="12" rx="9" ry="4.5" transform="rotate(-30 12 12)" />
  <circle cx="12" cy="12" r="2" fill="currentColor" />
  <circle cx="5" cy="9" r="0.8" fill="currentColor" />
  <circle cx="19" cy="15" r="0.8" fill="currentColor" />
  <circle cx="15" cy="6" r="0.6" fill="currentColor" />
  <circle cx="9" cy="18" r="0.6" fill="currentColor" />
  <path d="M12 2v2M12 20v2M2 12h2M20 12h2" stroke-dasharray="1 3" opacity="0.5" />
</svg>
