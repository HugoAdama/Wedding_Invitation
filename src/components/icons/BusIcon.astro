---
interface Props {
  class?: string;
  size?: number | string;
}

const { class: className = "w-6 h-6", size = 24 } = Astro.props;
---
<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
>
  <rect x="4" y="3" width="16" height="15" rx="2" />
  <path d="M4 11h16" />
  <path d="M8 3v4" />
  <path d="M16 3v4" />
  <circle cx="8" cy="15" r="1" fill="currentColor" />
  <circle cx="16" cy="15" r="1" fill="currentColor" />
  <path d="M6 18v3" />
  <path d="M18 18v3" />
</svg>
