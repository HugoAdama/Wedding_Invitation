---
interface Props {
  class?: string;
  size?: number | string;
}

const { class: className = "w-5 h-5", size = 20 } = Astro.props;
---
<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
>
  <polyline points="20 6 9 17 4 12" />
</svg>
