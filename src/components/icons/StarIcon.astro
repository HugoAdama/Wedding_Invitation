---
interface Props {
  class?: string;
  size?: number | string;
}

const { class: className = "w-5 h-5", size = 20 } = Astro.props;
---
<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="currentColor"
  stroke="none"
  class={className}
  aria-hidden="true"
>
  <path d="M12 2l2.9 6.8 7.1.6-5.4 4.7 1.6 7-6.2-3.8-6.2 3.8 1.6-7-5.4-4.7 7.1-.6L12 2z" />
</svg>
