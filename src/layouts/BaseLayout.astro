---
import '../styles/global.css';
import Header from '../components/sections/Header.astro';
import Footer from '../components/sections/Footer.astro';
import StarCanvas from '../components/ui/StarCanvas.astro';
import { weddingData } from '../data/wedding';
import { withBase } from '../utils/paths';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = "Daniela & Rodrigo · Bajo las estrellas · 12 de junio de 2027",
  description = "Daniela y Rodrigo se casan el sábado 12 de junio de 2027 en Arequipa, bajo las estrellas. Conoce todos los detalles y confirma tu asistencia.",
  ogImage = "/images/pareja.webp"
} = Astro.props;
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="generator" content={Astro.generator} />
  
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content="noindex, nofollow" />

  <!-- Open Graph / Meta Social -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content="Daniela & Rodrigo · Boda bajo las estrellas" />
  <meta property="og:description" content="Sábado 12 de junio de 2027 · Hacienda San José, Arequipa. Confirma tu asistencia antes del 15 de abril." />
  <meta property="og:image" content={withBase(ogImage)} />
  <meta property="og:locale" content="es_PE" />

  <!-- Favicon celestial -->
  <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />

  <!-- Google Fonts: Cormorant Garamond, Great Vibes, Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Great+Vibes&family=Inter:wght@400;500;600&display=swap"
    rel="stylesheet"
  />
</head>
<body>
  <a class="saltar-contenido" href="#inicio">Saltar al contenido principal</a>

  <!-- Lienzo interactivo de polvo de estrellas y constelaciones -->
  <StarCanvas />

  <Header />

  <main id="main-content">
    <slot />
  </main>

  <Footer />

  <script>
    // Observador de revelación poética de elementos en scroll
    function setupScrollReveal() {
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.querySelectorAll('.revelar').forEach(el => el.classList.add('revelar--activo'));
        return;
      }

      const observador = new IntersectionObserver(
        (entradas) => {
          entradas.forEach((entrada) => {
            if (entrada.isIntersecting) {
              entrada.target.classList.add('revelar--activo');
              observador.unobserve(entrada.target);
            }
          });
        },
        { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
      );

      document.querySelectorAll('.revelar').forEach((el) => {
        observador.observe(el);
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupScrollReveal);
    } else {
      setupScrollReveal();
    }
  </script>
</body>
</html>
