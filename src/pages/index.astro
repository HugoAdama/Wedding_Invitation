---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
import WelcomeMessage from '../components/sections/WelcomeMessage.astro';
import CoupleSection from '../components/sections/CoupleSection.astro';
import TriviaSection from '../components/sections/TriviaSection.astro';
import StoryTimeline from '../components/sections/StoryTimeline.astro';
import EventDetails from '../components/sections/EventDetails.astro';
import CountdownSection from '../components/sections/CountdownSection.astro';
import NightExperience from '../components/sections/NightExperience.astro';
import GallerySection from '../components/sections/GallerySection.astro';
import DressCodeSection from '../components/sections/DressCodeSection.astro';
import HotelsSection from '../components/sections/HotelsSection.astro';
import RecommendationsSection from '../components/sections/RecommendationsSection.astro';
import GiftsSection from '../components/sections/GiftsSection.astro';
import RsvpSection from '../components/sections/RsvpSection.astro';
import FaqSection from '../components/sections/FaqSection.astro';
import ContactSection from '../components/sections/ContactSection.astro';
---

<BaseLayout
  title="Daniela & Rodrigo · Bajo las estrellas · 12 de junio de 2027"
  description="Daniela y Rodrigo se casan el sábado 12 de junio de 2027 en Arequipa, bajo las estrellas. Conoce el itinerario, detalles y confirma tu asistencia."
>
  <Hero />
  <WelcomeMessage />
  <CoupleSection />
  <TriviaSection />
  <StoryTimeline />
  <EventDetails />
  <CountdownSection />
  <NightExperience />
  <GallerySection />
  <DressCodeSection />
  <HotelsSection />
  <RecommendationsSection />
  <GiftsSection />
  <RsvpSection />
  <FaqSection />
  <ContactSection />
</BaseLayout>
